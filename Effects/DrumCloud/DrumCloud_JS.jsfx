gfx_drawstr("%  ");
analysis_status == 0 ? gfx_drawstr("NOT ANALYZED");
analysis_status == 1 ? gfx_drawstr("READY");
analysis_status == 4 ? gfx_drawstr("APPLIED");
analysis_status == 2 ? gfx_drawstr("LOW / MANUAL KEPT");
analysis_status == 3 ? gfx_drawstr("ANALYZING");

