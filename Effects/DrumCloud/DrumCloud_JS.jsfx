gfx_x = 30;
gfx_y = 1100;

note_held ? (

    gfx_set(
        0.35,
        1.0,
        0.45,
        1
    );

    gfx_drawstr(
        "CLOUD ACTIVE"
    );

) : (

    active_grains > 0 ? (

        gfx_set(
            1.0,
            0.75,
            0.25,
            1
        );

        gfx_drawstr(
            "GRAINS DECAYING..."
        );

    ) : (

        gfx_set(
            0.55,
            0.55,
            0.60,
            1
        );

        gfx_drawstr(
            "WAITING FOR MIDI..."
        );
    );
);
