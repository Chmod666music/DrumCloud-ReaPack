detected_root_note >= 0 ? (
    strcpy(#note_names, "C C#D D#E F F#G G#A A#B ");
    strcpy_substr(#detected_name, #note_names, (detected_root_note % 12)*2, 2);
    gfx_drawstr(#detected_name);
    gfx_drawnumber(floor(detected_root_note/12)-1, 0);
    gfx_drawstr(" / MIDI "); gfx_drawnumber(detected_root_note, 0);
) : gfx_drawstr("--");

gfx_x = 500;
gfx_y = 445;
