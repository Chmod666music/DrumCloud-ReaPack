tags:instrument sampler granular
options:maxmem=128000000

slider1:/DrumCloud:Reverbera_851134_y2-6-percussions-iterative-slight-variation.wav:Sample
slider2:root_note=60<0,127,1>Root MIDI note
slider3:grain_size_ms=180<10,1000,1>Grain Size (ms)
slider4:grain_position=0.50<0,1,0.001>Position
slider5:density=8<1,40,0.1>Density (grains/sec)
slider6:position_spread=0.10<0,1,0.001>Position Spread
slider7:scan_speed=0.05<-1,1,0.001>Scan Speed
slider8:scan_on=0<0,1,1{Off,On}>Scan
slider9:stereo_spread=0.50<0,1,0.001>Stereo Spread
slider10:output_db=-6<-60,6,0.1>Output (dB)
slider11:position_mode=2<0,4,1{Forward,Backward,Ping Pong,Random Jump,Random Walk}>Position Mode
slider12:sample_start=0<0,1,0.001>Sample Start
slider13:sample_end=1<0,1,0.001>Sample End
slider14:pitch_spread=0<0,12,0.1>Pitch Spread (semitones)
slider15:attack_ms=10<0,500,1>Attack (ms)
slider16:release_ms=80<0,1000,1>Release (ms)
slider17:reverb_mode=0<0,3,1{Off,Room,Hall,Shimmer}>Reverb Mode
slider18:reverb_mix=0.25<0,1,0.001>Reverb Mix
slider19:reverb_size=0.50<0,1,0.001>Reverb Size
slider20:reverb_decay=2.5<0.1,20,0.1>Reverb Decay (s)
slider21:reverb_damping=0.45<0,1,0.001>Reverb Damping
slider22:shimmer_amount=0.35<0,1,0.001>Shimmer Amount
slider23:delay_mode=0<0,2,1{Off,Stereo,Ping Pong}>Delay Mode
slider24:delay_time_l_ms=375<1,2000,1>Delay Time L (ms)
slider25:delay_time_r_ms=500<1,2000,1>Delay Time R (ms)
slider26:delay_feedback=0.35<0,0.90,0.001>Delay Feedback
slider27:delay_mix=0.25<0,1,0.001>Delay Mix
slider28:delay_damping=0.35<0,1,0.001>Delay Damping

@init

version = 0.23;


// ==================================================
// MEMORY LAYOUT
// ==================================================

max_grains = 8;

active_base    = 0;
phase_base     = 16;
start_base     = 32;
step_base      = 48;
length_base    = 64;
velocity_base  = 80;
pan_base       = 96;

// Fixed reverb memory stays below the dynamically loaded sample.
reverb_max_delay = 65536;
allpass_max_delay = 16384;

comb_l1_base = 1024;
comb_l2_base = comb_l1_base + reverb_max_delay;
comb_l3_base = comb_l2_base + reverb_max_delay;
comb_l4_base = comb_l3_base + reverb_max_delay;
comb_r1_base = comb_l4_base + reverb_max_delay;
comb_r2_base = comb_r1_base + reverb_max_delay;
comb_r3_base = comb_r2_base + reverb_max_delay;
comb_r4_base = comb_r3_base + reverb_max_delay;

allpass_l1_base = comb_r4_base + reverb_max_delay;
allpass_l2_base = allpass_l1_base + allpass_max_delay;
allpass_r1_base = allpass_l2_base + allpass_max_delay;
allpass_r2_base = allpass_r1_base + allpass_max_delay;

shimmer_max_delay = 32768;
shimmer_l_base = allpass_r2_base + allpass_max_delay;
shimmer_r_base = shimmer_l_base + shimmer_max_delay;

reverb_memory_end =
    shimmer_r_base +
    shimmer_max_delay;

delay_max_samples = 524288;
delay_l_base = reverb_memory_end;
delay_r_base = delay_l_base + delay_max_samples;
effects_memory_end = delay_r_base + delay_max_samples;

sample_buffer = 2097152;

reverb_write_pos = 0;
allpass_write_pos = 0;
shimmer_write_pos = 0;
shimmer_phase = 0;
shimmer_feedback_l = 0;
shimmer_feedback_r = 0;
last_reverb_mode = -1;

delay_write_pos = 0;
delay_l_damp = 0;
delay_r_damp = 0;
last_delay_mode = -1;

output_limiter_gain = 1;

comb_l1_damp = 0;
comb_l2_damp = 0;
comb_l3_damp = 0;
comb_l4_damp = 0;
comb_r1_damp = 0;
comb_r2_damp = 0;
comb_r3_damp = 0;
comb_r4_damp = 0;

// Clear all reverb delay memory on startup.
reverb_clear_index = 1024;
loop(
    reverb_memory_end - 1024,
    reverb_clear_index[0] = 0;
    reverb_clear_index += 1;
);

delay_clear_index = reverb_memory_end;
loop(
    effects_memory_end - reverb_memory_end,
    delay_clear_index[0] = 0;
    delay_clear_index += 1;
);


// ==================================================
// SAMPLE STATE
// ==================================================

sample_length = 0;
sample_channels = 0;
sample_samplerate = 0;
frame_count = 0;
scan_position = 0.5;
range_start = 0;
range_end = 1;
scan_direction = 1;
scan_random_counter = 0;
random_walk_direction = 0;
last_position_mode = 2;
last_scan_on = 0;

last_sample = -1;


// ==================================================
// MIDI / CLOUD STATE
// ==================================================

note_held = 0;

current_note = -1;
current_velocity = 0;

pitch_ratio = 1;
playback_step = 1;

spawn_counter = 0;

active_grains = 0;


// ==================================================
// INITIAL CLEAR
// ==================================================

i = 0;

loop(max_grains,

    active_base[i] = 0;
    phase_base[i] = 0;
    start_base[i] = 0;
    step_base[i] = 1;
    length_base[i] = 1;
    velocity_base[i] = 0;
    pan_base[i] = 0;

    i += 1;
);


// ==================================================
// SLIDERS / SAMPLE LOADING
// ==================================================

@slider

output_gain =
    10 ^ (output_db / 20);

// Changing reverb structure starts with a clean, predictable room.
reverb_mode != last_reverb_mode ? (
    reverb_clear_index = 1024;

    loop(
        reverb_memory_end - 1024,
        reverb_clear_index[0] = 0;
        reverb_clear_index += 1;
    );

    reverb_write_pos = 0;
    allpass_write_pos = 0;
    shimmer_write_pos = 0;
    shimmer_phase = 0;
    shimmer_feedback_l = 0;
    shimmer_feedback_r = 0;

    comb_l1_damp = 0;
    comb_l2_damp = 0;
    comb_l3_damp = 0;
    comb_l4_damp = 0;
    comb_r1_damp = 0;
    comb_r2_damp = 0;
    comb_r3_damp = 0;
    comb_r4_damp = 0;

    last_reverb_mode = reverb_mode;
);

size_scale =
    0.65 +
    reverb_size *
    1.35;

reverb_mode == 1 ? (
    delay_ms_1 = 17.3;
    delay_ms_2 = 23.1;
    delay_ms_3 = 31.7;
    delay_ms_4 = 37.9;
    allpass_ms_1 = 4.7;
    allpass_ms_2 = 1.7;
) : (
    delay_ms_1 = 29.7;
    delay_ms_2 = 37.1;
    delay_ms_3 = 41.1;
    delay_ms_4 = 43.7;
    allpass_ms_1 = 7.1;
    allpass_ms_2 = 2.3;
);

delay_l1 = max(1, min(reverb_max_delay - 1, floor(delay_ms_1 * 0.001 * srate * size_scale)));
delay_l2 = max(1, min(reverb_max_delay - 1, floor(delay_ms_2 * 0.001 * srate * size_scale)));
delay_l3 = max(1, min(reverb_max_delay - 1, floor(delay_ms_3 * 0.001 * srate * size_scale)));
delay_l4 = max(1, min(reverb_max_delay - 1, floor(delay_ms_4 * 0.001 * srate * size_scale)));

stereo_offset =
    max(
        1,
        floor(1.1 * 0.001 * srate)
    );

delay_r1 = max(1, min(reverb_max_delay - 1, delay_l1 + stereo_offset));
delay_r2 = max(1, min(reverb_max_delay - 1, delay_l2 + stereo_offset));
delay_r3 = max(1, min(reverb_max_delay - 1, delay_l3 + stereo_offset));
delay_r4 = max(1, min(reverb_max_delay - 1, delay_l4 + stereo_offset));

decay_seconds = max(0.1, reverb_decay);

// Shimmer has a second feedback path and therefore needs more headroom.
feedback_ceiling =
    reverb_mode == 3 ?
    0.90 :
    0.975;

feedback_l1 = min(feedback_ceiling, 10 ^ (-3 * delay_l1 / (srate * decay_seconds)));
feedback_l2 = min(feedback_ceiling, 10 ^ (-3 * delay_l2 / (srate * decay_seconds)));
feedback_l3 = min(feedback_ceiling, 10 ^ (-3 * delay_l3 / (srate * decay_seconds)));
feedback_l4 = min(feedback_ceiling, 10 ^ (-3 * delay_l4 / (srate * decay_seconds)));
feedback_r1 = min(feedback_ceiling, 10 ^ (-3 * delay_r1 / (srate * decay_seconds)));
feedback_r2 = min(feedback_ceiling, 10 ^ (-3 * delay_r2 / (srate * decay_seconds)));
feedback_r3 = min(feedback_ceiling, 10 ^ (-3 * delay_r3 / (srate * decay_seconds)));
feedback_r4 = min(feedback_ceiling, 10 ^ (-3 * delay_r4 / (srate * decay_seconds)));

damping_coefficient =
    max(
        0.02,
        1 -
        reverb_damping *
        0.98
    );

allpass_delay_l1 = max(1, min(allpass_max_delay - 1, floor(allpass_ms_1 * 0.001 * srate * size_scale)));
allpass_delay_l2 = max(1, min(allpass_max_delay - 1, floor(allpass_ms_2 * 0.001 * srate * size_scale)));
allpass_delay_r1 = max(1, min(allpass_max_delay - 1, allpass_delay_l1 + stereo_offset));
allpass_delay_r2 = max(1, min(allpass_max_delay - 1, allpass_delay_l2 + stereo_offset));

shimmer_window_frames =
    max(
        256,
        min(
            shimmer_max_delay - 64,
            floor(0.08 * srate)
        )
    );

shimmer_phase_increment =
    1 /
    shimmer_window_frames;

output_limiter_release =
    1 -
    exp(
        -1 /
        max(
            1,
            0.10 * srate
        )
    );

delay_mode != last_delay_mode ? (
    delay_clear_index = reverb_memory_end;

    loop(
        effects_memory_end - reverb_memory_end,
        delay_clear_index[0] = 0;
        delay_clear_index += 1;
    );

    delay_write_pos = 0;
    delay_l_damp = 0;
    delay_r_damp = 0;
    last_delay_mode = delay_mode;
);

delay_samples_l =
    max(
        1,
        min(
            delay_max_samples - 1,
            floor(
                delay_time_l_ms *
                0.001 *
                srate
            )
        )
    );

delay_samples_r =
    max(
        1,
        min(
            delay_max_samples - 1,
            floor(
                delay_time_r_ms *
                0.001 *
                srate
            )
        )
    );

delay_damping_coefficient =
    max(
        0.02,
        1 -
        delay_damping *
        0.98
    );

// Keep a valid range even if the automation lanes cross.
range_start = min(sample_start, sample_end);
range_end = max(sample_start, sample_end);

range_end - range_start < 0.001 ? (
    range_end = min(1, range_start + 0.001);
    range_end - range_start < 0.001 ? (
        range_start = max(0, range_end - 0.001);
    );
);

grain_position = max(range_start, min(range_end, grain_position));
scan_position = max(range_start, min(range_end, scan_position));

scan_on && !last_scan_on ? (
    scan_position = grain_position;
    scan_direction = 1;
    scan_random_counter = 0;
);

position_mode != last_position_mode ? (
    scan_direction = 1;
    scan_random_counter = 0;
    last_position_mode = position_mode;
);

!scan_on ? (
    scan_position = grain_position;
);

last_scan_on = scan_on;


slider1 != last_sample ? (

    handle = file_open(slider1);

    handle >= 0 ? (

        file_riff(
            handle,
            sample_channels,
            sample_samplerate
        );

        sample_length =
            file_avail(handle);

        sample_length > 0 ? (

            file_mem(
                handle,
                sample_buffer,
                sample_length
            );
        );

        file_close(handle);


        sample_channels > 0 ? (

            frame_count =
                sample_length /
                sample_channels;
        );


        // Stop existing grains
        i = 0;

        loop(max_grains,

            active_base[i] = 0;

            i += 1;
        );

        active_grains = 0;
    );

    last_sample = slider1;
);


// ==================================================
// MIDI
// ==================================================

@block

while (
    midirecv(offset, msg1, msg23) ?

    (

        status =
            msg1 & $xF0;

        note =
            msg23 & $x7F;

        velocity =
            (msg23 / 256) & $x7F;


        // ------------------------------------------
        // NOTE ON
        // ------------------------------------------

        status == $x90 &&
        velocity > 0 ? (

            current_note = note;
            current_velocity = velocity;


            pitch_ratio =
                2 ^
                (
                    (note - root_note)
                    /
                    12
                );


            playback_step =
                pitch_ratio *
                (
                    sample_samplerate /
                    srate
                );


            note_held = 1;

            // Spawn first grain immediately
            spawn_counter = 0;
        );


        // ------------------------------------------
        // NOTE OFF
        // ------------------------------------------

        (
            status == $x80
        )
        ||
        (
            status == $x90 &&
            velocity == 0
        ) ? (

            note == current_note ? (

                note_held = 0;
            );
        );


        1;
    );
);


// ==================================================
// AUDIO
// ==================================================

@sample

out_l = 0;
out_r = 0;

// ==================================================
// POSITION MODES
// ==================================================

scan_on && frame_count > 1 ? (

    // Forward: always move right and wrap at the end.
    position_mode == 0 ? (
        scan_position += abs(scan_speed) / srate;
        scan_position >= range_end ? (
            scan_position = range_start + (scan_position - range_end);
        );
    );

    // Backward: always move left and wrap at the start.
    position_mode == 1 ? (
        scan_position -= abs(scan_speed) / srate;
        scan_position < range_start ? (
            scan_position = range_end - (range_start - scan_position);
        );
    );

    // Ping Pong: reflect naturally at both ends.
    position_mode == 2 ? (
        scan_position +=
            scan_speed *
            scan_direction /
            srate;

        scan_position > range_end ? (
            scan_position = 2 * range_end - scan_position;
            scan_direction = -scan_direction;
        );

        scan_position < range_start ? (
            scan_position = 2 * range_start - scan_position;
            scan_direction = -scan_direction;
        );
    );

    // Random Jump: Scan Speed controls jumps per second.
    position_mode == 3 && abs(scan_speed) > 0 ? (
        scan_random_counter <= 0 ? (
            scan_position =
                range_start +
                rand(1) *
                (range_end - range_start);
            scan_random_counter =
                srate /
                max(
                    0.01,
                    abs(scan_speed)
                );
        );

        scan_random_counter -= 1;
    );

    // Random Walk: choose a new drift direction four times per second.
    position_mode == 4 && abs(scan_speed) > 0 ? (
        scan_random_counter <= 0 ? (
            random_walk_direction = rand(2) - 1;
            scan_random_counter = srate * 0.25;
        );

        scan_random_counter -= 1;

        scan_position +=
            random_walk_direction *
            abs(scan_speed) /
            srate;

        scan_position > range_end ? (
            scan_position = 2 * range_end - scan_position;
            random_walk_direction = -abs(random_walk_direction);
        );

        scan_position < range_start ? (
            scan_position = 2 * range_start - scan_position;
            random_walk_direction = abs(random_walk_direction);
        );
    );

    scan_position = max(range_start, min(range_end, scan_position));

    grain_position =
        scan_position;
);


// ==================================================
// SPAWN GRAINS
// ==================================================

note_held &&
frame_count > 1 ? (

    spawn_counter <= 0 ? (

        free_grain = -1;

        i = 0;


        loop(max_grains,

            free_grain < 0 &&
            active_base[i] == 0 ? (

                free_grain = i;
            );

            i += 1;
        );


        // ------------------------------------------
        // CREATE GRAIN
        // ------------------------------------------

        free_grain >= 0 ? (

            // Give each grain an independent detune around the MIDI pitch.
            grain_detune =
                pitch_spread > 0 ?
                (
                    (rand(2) - 1) *
                    pitch_spread
                ) :
                0;

            grain_pitch_ratio =
                2 ^
                (
                    grain_detune /
                    12
                );

            grain_step =
                playback_step *
                grain_pitch_ratio;

            grain_frames =
                max(
                    1,
                    grain_size_ms *
                    0.001 *
                    srate
                );

            range_start_frame =
                range_start *
                (frame_count - 1);

            range_end_frame =
                range_end *
                (frame_count - 1);

            range_source_length =
                max(
                    1,
                    range_end_frame -
                    range_start_frame -
                    2
                );

            // Short ranges shorten grains so playback stays in range.
            grain_frames =
                min(
                    grain_frames,
                    max(
                        1,
                        range_source_length /
                        max(0.000001, grain_step)
                    )
                );

            grain_source_length =
                grain_frames *
                grain_step;

            range_max_start =
                max(
                    range_start_frame,
                    range_end_frame -
                    grain_source_length
                );


        // --------------------------------------
        // POSITION SPREAD
        // --------------------------------------

        random_offset =
            (rand(2) - 1) *
            position_spread;

        // Spread is relative to whole sample
        spread_position =
            grain_position +
            random_offset;

        // Keep every grain inside the selected sample range.
        spread_position =
            max(
                range_start,
                min(
                    range_end,
                    spread_position
                )
            );

        range_position =
            (spread_position - range_start) /
            max(0.001, range_end - range_start);

        grain_start =
            range_start_frame +
            range_position *
            (range_max_start - range_start_frame);


            // RANDOM PAN
            grain_pan =
                (
                    rand(2) - 1
                )
                *
                stereo_spread;


            active_base[free_grain] =
                1;

            phase_base[free_grain] =
                0;

            start_base[free_grain] =
                grain_start;

            step_base[free_grain] =
                grain_step;

            length_base[free_grain] =
                grain_frames;

            velocity_base[free_grain] =
                current_velocity /
                127;

            pan_base[free_grain] =
                grain_pan;
        );


        // ------------------------------------------
        // NEXT GRAIN
        // ------------------------------------------

        spawn_counter =
            srate /
            max(
                0.1,
                density
            );
    );


    spawn_counter -= 1;
);


// ==================================================
// PROCESS ACTIVE GRAINS
// ==================================================

active_grains = 0;

i = 0;


loop(max_grains,

    active_base[i] ? (

        grain_phase =
            phase_base[i];

        grain_length =
            length_base[i];

        grain_step =
            step_base[i];

        grain_pan =
            pan_base[i];


        source_pos =
            start_base[i] +
            grain_phase *
            grain_step;


        (
            grain_phase <
            grain_length
        )
        &&
        (
            source_pos <
            frame_count - 1
        ) ? (


            // --------------------------------------
            // INTERPOLATION
            // --------------------------------------

            frame_int =
                floor(
                    source_pos
                );


            frac =
                source_pos -
                frame_int;


            next_frame =
                min(
                    frame_int + 1,
                    frame_count - 1
                );


            // --------------------------------------
            // MONO
            // --------------------------------------

            sample_channels == 1 ? (

                s1 =
                    sample_buffer[
                        frame_int
                    ];

                s2 =
                    sample_buffer[
                        next_frame
                    ];


                grain_l =
                    s1 +
                    (
                        s2 - s1
                    ) *
                    frac;


                grain_r =
                    grain_l;

            ) : (


                // ----------------------------------
                // STEREO
                // ----------------------------------

                idx1 =
                    frame_int *
                    sample_channels;


                idx2 =
                    next_frame *
                    sample_channels;


                l1 =
                    sample_buffer[
                        idx1
                    ];

                l2 =
                    sample_buffer[
                        idx2
                    ];

                r1 =
                    sample_buffer[
                        idx1 + 1
                    ];

                r2 =
                    sample_buffer[
                        idx2 + 1
                    ];


                grain_l =
                    l1 +
                    (
                        l2 - l1
                    ) *
                    frac;


                grain_r =
                    r1 +
                    (
                        r2 - r1
                    ) *
                    frac;
            );


            // --------------------------------------
            // ADJUSTABLE ATTACK / RELEASE ENVELOPE
            // --------------------------------------

            available_env_frames =
                max(
                    1,
                    grain_length - 1
                );

            attack_frames =
                max(
                    0,
                    attack_ms *
                    0.001 *
                    srate
                );

            release_frames =
                max(
                    0,
                    release_ms *
                    0.001 *
                    srate
                );

            envelope_frames =
                attack_frames +
                release_frames;

            // Scale both stages proportionally when the grain is too short.
            envelope_frames > available_env_frames ? (
                envelope_scale =
                    available_env_frames /
                    max(
                        0.000001,
                        envelope_frames
                    );

                attack_frames *= envelope_scale;
                release_frames *= envelope_scale;
            );

            grain_env = 1;

            attack_frames > 0 &&
            grain_phase < attack_frames ? (
                attack_progress =
                    max(
                        0,
                        min(
                            1,
                            grain_phase /
                            attack_frames
                        )
                    );

                grain_env =
                    0.5 -
                    0.5 *
                    cos(
                        $pi *
                        attack_progress
                    );
            );

            release_frames > 0 &&
            grain_phase > available_env_frames - release_frames ? (
                release_progress =
                    max(
                        0,
                        min(
                            1,
                            (
                                available_env_frames -
                                grain_phase
                            ) /
                            release_frames
                        )
                    );

                release_env =
                    0.5 -
                    0.5 *
                    cos(
                        $pi *
                        release_progress
                    );

                grain_env =
                    min(
                        grain_env,
                        release_env
                    );
            );


            // --------------------------------------
            // EQUAL POWER PAN
            // --------------------------------------

            pan_l =
                sqrt(
                    0.5 *
                    (
                        1 -
                        grain_pan
                    )
                );


            pan_r =
                sqrt(
                    0.5 *
                    (
                        1 +
                        grain_pan
                    )
                );


            grain_gain =
                grain_env *
                velocity_base[i];


            grain_l *=
                grain_gain *
                pan_l;


            grain_r *=
                grain_gain *
                pan_r;


            // --------------------------------------
            // MIX
            // --------------------------------------

            out_l += grain_l;
            out_r += grain_r;


            phase_base[i] += 1;

            active_grains += 1;

        ) : (

            active_base[i] = 0;
        );
    );


    i += 1;
);


// ==================================================
// CLOUD NORMALIZATION
// ==================================================

cloud_gain =
    1 /
    sqrt(
        max(
            1,
            active_grains
        )
    );


out_l *= cloud_gain;
out_r *= cloud_gain;


// ==================================================
// STEREO CLOUD REVERB
// ==================================================

reverb_mode > 0 ? (

    dry_l = out_l;
    dry_r = out_r;

    reverb_input_l =
        (
            dry_l +
            dry_r * 0.15 +
            shimmer_feedback_l *
            shimmer_amount
        ) *
        0.70;

    reverb_input_r =
        (
            dry_r +
            dry_l * 0.15 +
            shimmer_feedback_r *
            shimmer_amount
        ) *
        0.70;

    read_l1 = (reverb_write_pos - delay_l1 + reverb_max_delay) % reverb_max_delay;
    read_l2 = (reverb_write_pos - delay_l2 + reverb_max_delay) % reverb_max_delay;
    read_l3 = (reverb_write_pos - delay_l3 + reverb_max_delay) % reverb_max_delay;
    read_l4 = (reverb_write_pos - delay_l4 + reverb_max_delay) % reverb_max_delay;
    read_r1 = (reverb_write_pos - delay_r1 + reverb_max_delay) % reverb_max_delay;
    read_r2 = (reverb_write_pos - delay_r2 + reverb_max_delay) % reverb_max_delay;
    read_r3 = (reverb_write_pos - delay_r3 + reverb_max_delay) % reverb_max_delay;
    read_r4 = (reverb_write_pos - delay_r4 + reverb_max_delay) % reverb_max_delay;

    comb_l1_out = comb_l1_base[read_l1];
    comb_l2_out = comb_l2_base[read_l2];
    comb_l3_out = comb_l3_base[read_l3];
    comb_l4_out = comb_l4_base[read_l4];
    comb_r1_out = comb_r1_base[read_r1];
    comb_r2_out = comb_r2_base[read_r2];
    comb_r3_out = comb_r3_base[read_r3];
    comb_r4_out = comb_r4_base[read_r4];

    comb_l1_damp += damping_coefficient * (comb_l1_out - comb_l1_damp);
    comb_l2_damp += damping_coefficient * (comb_l2_out - comb_l2_damp);
    comb_l3_damp += damping_coefficient * (comb_l3_out - comb_l3_damp);
    comb_l4_damp += damping_coefficient * (comb_l4_out - comb_l4_damp);
    comb_r1_damp += damping_coefficient * (comb_r1_out - comb_r1_damp);
    comb_r2_damp += damping_coefficient * (comb_r2_out - comb_r2_damp);
    comb_r3_damp += damping_coefficient * (comb_r3_out - comb_r3_damp);
    comb_r4_damp += damping_coefficient * (comb_r4_out - comb_r4_damp);

    comb_l1_base[reverb_write_pos] = reverb_input_l + comb_l1_damp * feedback_l1;
    comb_l2_base[reverb_write_pos] = reverb_input_l + comb_l2_damp * feedback_l2;
    comb_l3_base[reverb_write_pos] = reverb_input_l + comb_l3_damp * feedback_l3;
    comb_l4_base[reverb_write_pos] = reverb_input_l + comb_l4_damp * feedback_l4;
    comb_r1_base[reverb_write_pos] = reverb_input_r + comb_r1_damp * feedback_r1;
    comb_r2_base[reverb_write_pos] = reverb_input_r + comb_r2_damp * feedback_r2;
    comb_r3_base[reverb_write_pos] = reverb_input_r + comb_r3_damp * feedback_r3;
    comb_r4_base[reverb_write_pos] = reverb_input_r + comb_r4_damp * feedback_r4;

    wet_l =
        (
            comb_l1_out +
            comb_l2_out +
            comb_l3_out +
            comb_l4_out
        ) *
        0.25;

    wet_r =
        (
            comb_r1_out +
            comb_r2_out +
            comb_r3_out +
            comb_r4_out
        ) *
        0.25;

    reverb_write_pos =
        (reverb_write_pos + 1) %
        reverb_max_delay;

    ap_read_l1 = (allpass_write_pos - allpass_delay_l1 + allpass_max_delay) % allpass_max_delay;
    ap_read_l2 = (allpass_write_pos - allpass_delay_l2 + allpass_max_delay) % allpass_max_delay;
    ap_read_r1 = (allpass_write_pos - allpass_delay_r1 + allpass_max_delay) % allpass_max_delay;
    ap_read_r2 = (allpass_write_pos - allpass_delay_r2 + allpass_max_delay) % allpass_max_delay;

    ap_l1_delayed = allpass_l1_base[ap_read_l1];
    ap_l1_out = ap_l1_delayed - wet_l;
    allpass_l1_base[allpass_write_pos] = wet_l + ap_l1_delayed * 0.5;

    ap_l2_delayed = allpass_l2_base[ap_read_l2];
    ap_l2_out = ap_l2_delayed - ap_l1_out;
    allpass_l2_base[allpass_write_pos] = ap_l1_out + ap_l2_delayed * 0.5;

    ap_r1_delayed = allpass_r1_base[ap_read_r1];
    ap_r1_out = ap_r1_delayed - wet_r;
    allpass_r1_base[allpass_write_pos] = wet_r + ap_r1_delayed * 0.5;

    ap_r2_delayed = allpass_r2_base[ap_read_r2];
    ap_r2_out = ap_r2_delayed - ap_r1_out;
    allpass_r2_base[allpass_write_pos] = ap_r1_out + ap_r2_delayed * 0.5;

    allpass_write_pos =
        (allpass_write_pos + 1) %
        allpass_max_delay;

    // ----------------------------------------------
    // DUAL-HEAD OCTAVE-UP SHIMMER FEEDBACK
    // ----------------------------------------------

    reverb_mode == 3 ? (

        shimmer_head_1 = shimmer_phase;
        shimmer_head_2 = (shimmer_phase + 0.5) % 1;

        shimmer_delay_1 =
            32 +
            (1 - shimmer_head_1) *
            (shimmer_window_frames - 64);

        shimmer_delay_2 =
            32 +
            (1 - shimmer_head_2) *
            (shimmer_window_frames - 64);

        shimmer_read_1 =
            shimmer_write_pos -
            shimmer_delay_1;

        shimmer_read_2 =
            shimmer_write_pos -
            shimmer_delay_2;

        shimmer_read_1 < 0 ? shimmer_read_1 += shimmer_max_delay;
        shimmer_read_2 < 0 ? shimmer_read_2 += shimmer_max_delay;

        shimmer_index_1 = floor(shimmer_read_1);
        shimmer_index_2 = floor(shimmer_read_2);
        shimmer_next_1 = (shimmer_index_1 + 1) % shimmer_max_delay;
        shimmer_next_2 = (shimmer_index_2 + 1) % shimmer_max_delay;
        shimmer_frac_1 = shimmer_read_1 - shimmer_index_1;
        shimmer_frac_2 = shimmer_read_2 - shimmer_index_2;

        shimmer_l_head_1 =
            shimmer_l_base[shimmer_index_1] +
            (
                shimmer_l_base[shimmer_next_1] -
                shimmer_l_base[shimmer_index_1]
            ) *
            shimmer_frac_1;

        shimmer_l_head_2 =
            shimmer_l_base[shimmer_index_2] +
            (
                shimmer_l_base[shimmer_next_2] -
                shimmer_l_base[shimmer_index_2]
            ) *
            shimmer_frac_2;

        shimmer_r_head_1 =
            shimmer_r_base[shimmer_index_1] +
            (
                shimmer_r_base[shimmer_next_1] -
                shimmer_r_base[shimmer_index_1]
            ) *
            shimmer_frac_1;

        shimmer_r_head_2 =
            shimmer_r_base[shimmer_index_2] +
            (
                shimmer_r_base[shimmer_next_2] -
                shimmer_r_base[shimmer_index_2]
            ) *
            shimmer_frac_2;

        shimmer_weight_1 =
            sin(
                $pi *
                shimmer_head_1
            );

        shimmer_weight_2 =
            sin(
                $pi *
                shimmer_head_2
            );

        shimmer_weight_sum =
            max(
                0.000001,
                shimmer_weight_1 +
                shimmer_weight_2
            );

        shimmer_pitch_l =
            (
                shimmer_l_head_1 * shimmer_weight_1 +
                shimmer_l_head_2 * shimmer_weight_2
            ) /
            shimmer_weight_sum;

        shimmer_pitch_r =
            (
                shimmer_r_head_1 * shimmer_weight_1 +
                shimmer_r_head_2 * shimmer_weight_2
            ) /
            shimmer_weight_sum;

        shimmer_raw_l =
            shimmer_pitch_l +
            shimmer_pitch_r * 0.10;

        shimmer_raw_r =
            shimmer_pitch_r +
            shimmer_pitch_l * 0.10;

        // Bounded soft feedback: never exceeds +/-0.16 per channel.
        shimmer_feedback_l =
            shimmer_raw_l /
            (
                1 +
                abs(shimmer_raw_l)
            ) *
            0.16;

        shimmer_feedback_r =
            shimmer_raw_r /
            (
                1 +
                abs(shimmer_raw_r)
            ) *
            0.16;

        shimmer_l_base[shimmer_write_pos] = ap_l2_out;
        shimmer_r_base[shimmer_write_pos] = ap_r2_out;

        shimmer_write_pos =
            (shimmer_write_pos + 1) %
            shimmer_max_delay;

        shimmer_phase += shimmer_phase_increment;
        shimmer_phase >= 1 ? shimmer_phase -= 1;

    ) : (

        shimmer_feedback_l = 0;
        shimmer_feedback_r = 0;
    );

    dry_gain =
        cos(
            reverb_mix *
            $pi *
            0.5
        );

    wet_gain =
        sin(
            reverb_mix *
            $pi *
            0.5
        );

    out_l =
        dry_l * dry_gain +
        ap_l2_out * wet_gain;

    out_r =
        dry_r * dry_gain +
        ap_r2_out * wet_gain;
);


// ==================================================
// STEREO / PING PONG DELAY
// ==================================================

delay_mode > 0 ? (

    delay_dry_l = out_l;
    delay_dry_r = out_r;

    delay_read_l =
        (
            delay_write_pos -
            delay_samples_l +
            delay_max_samples
        ) %
        delay_max_samples;

    delay_read_r =
        (
            delay_write_pos -
            delay_samples_r +
            delay_max_samples
        ) %
        delay_max_samples;

    delay_tap_l = delay_l_base[delay_read_l];
    delay_tap_r = delay_r_base[delay_read_r];

    delay_l_damp +=
        delay_damping_coefficient *
        (
            delay_tap_l -
            delay_l_damp
        );

    delay_r_damp +=
        delay_damping_coefficient *
        (
            delay_tap_r -
            delay_r_damp
        );

    // Stereo feeds each channel back into itself.
    delay_mode == 1 ? (
        delay_feedback_l =
            delay_l_damp *
            delay_feedback;

        delay_feedback_r =
            delay_r_damp *
            delay_feedback;

    ) : (

        // Ping Pong crosses the feedback between left and right.
        delay_feedback_l =
            delay_r_damp *
            delay_feedback;

        delay_feedback_r =
            delay_l_damp *
            delay_feedback;
    );

    delay_l_base[delay_write_pos] =
        delay_dry_l +
        delay_feedback_l;

    delay_r_base[delay_write_pos] =
        delay_dry_r +
        delay_feedback_r;

    delay_write_pos =
        (delay_write_pos + 1) %
        delay_max_samples;

    delay_dry_gain =
        cos(
            delay_mix *
            $pi *
            0.5
        );

    delay_wet_gain =
        sin(
            delay_mix *
            $pi *
            0.5
        );

    out_l =
        delay_dry_l * delay_dry_gain +
        delay_l_damp * delay_wet_gain;

    out_r =
        delay_dry_r * delay_dry_gain +
        delay_r_damp * delay_wet_gain;
);


// ==================================================
// OUTPUT
// ==================================================

pre_output_l =
    out_l *
    output_gain;

pre_output_r =
    out_r *
    output_gain;

output_peak =
    max(
        abs(pre_output_l),
        abs(pre_output_r)
    );

limiter_target =
    output_peak > 0.98 ?
    0.98 /
    output_peak :
    1;

limiter_target < output_limiter_gain ? (
    // Instant attack catches feedback spikes before they reach the output.
    output_limiter_gain = limiter_target;
) : (
    // Smooth 100 ms recovery avoids abrupt volume pumping.
    output_limiter_gain +=
        (
            1 -
            output_limiter_gain
        ) *
        output_limiter_release;
);

spl0 =
    pre_output_l *
    output_limiter_gain;

spl1 =
    pre_output_r *
    output_limiter_gain;


// ==================================================
// GUI
// ==================================================

@gfx 800 1180


// --------------------------------------------------
// BACKGROUND
// --------------------------------------------------

gfx_set(
    0.08,
    0.08,
    0.10,
    1
);

gfx_rect(
    0,
    0,
    gfx_w,
    gfx_h
);


// --------------------------------------------------
// TITLE
// --------------------------------------------------

gfx_set(
    0.92,
    0.92,
    0.92,
    1
);

gfx_setfont(
    1,
    "Arial",
    28
);

gfx_x = 30;
gfx_y = 25;

gfx_drawstr(
    "DRUMCLOUD JS"
);

gfx_setfont(
    1,
    "Arial",
    15
);

gfx_x = 30;
gfx_y = 65;

gfx_drawstr(
    "v0.23  STEREO DELAY"
);


// ==================================================
// WAVEFORM AREA
// ==================================================

wave_x = 30;
wave_y = 105;

wave_w =
    gfx_w - 60;

wave_h = 180;


// ==================================================
// MOUSE CONTROL
// ==================================================

// Is mouse inside waveform?

mouse_inside_wave =
    mouse_x >= wave_x &&
    mouse_x <= wave_x + wave_w &&
    mouse_y >= wave_y &&
    mouse_y <= wave_y + wave_h;


// Left mouse button currently down?

mouse_down =
    mouse_cap & 1;


// Start or continue dragging

mouse_inside_wave &&
mouse_down ? (

    grain_position =
        (mouse_x - wave_x) /
        wave_w;

    grain_position =
        max(
            range_start,
            min(
                range_end,
                grain_position
            )
        );

    scan_position =
        grain_position;

    sliderchange(slider4);
);


// ==================================================
// WAVEFORM BACKGROUND
// ==================================================

gfx_set(
    0.04,
    0.04,
    0.05,
    1
);

gfx_rect(
    wave_x,
    wave_y,
    wave_w,
    wave_h
);


// --------------------------------------------------
// CENTRE LINE
// --------------------------------------------------

gfx_set(
    0.22,
    0.22,
    0.25,
    1
);

gfx_line(
    wave_x,
    wave_y + wave_h * 0.5,
    wave_x + wave_w,
    wave_y + wave_h * 0.5
);


// ==================================================
// DRAW WAVEFORM
// ==================================================

frame_count > 1 ? (

    gfx_set(
        0.55,
        0.72,
        0.88,
        1
    );

    x = 0;

    last_wave_y =
        wave_y +
        wave_h * 0.5;

    loop(
        floor(wave_w),

        normalized_x =
            x /
            max(
                1,
                wave_w - 1
            );

        waveform_frame =
            floor(
                normalized_x *
                (
                    frame_count - 1
                )
            );

        sample_channels == 1 ? (

            waveform_value =
                sample_buffer[
                    waveform_frame
                ];

        ) : (

            waveform_index =
                waveform_frame *
                sample_channels;

            waveform_l =
                sample_buffer[
                    waveform_index
                ];

            waveform_r =
                sample_buffer[
                    waveform_index + 1
                ];

            waveform_value =
                (
                    waveform_l +
                    waveform_r
                )
                *
                0.5;
        );

        current_wave_y =
            wave_y +
            wave_h * 0.5 -
            waveform_value *
            wave_h *
            0.45;

        x > 0 ? (

            gfx_line(
                wave_x + x - 1,
                last_wave_y,
                wave_x + x,
                current_wave_y
            );
        );

        last_wave_y =
            current_wave_y;

        x += 1;
    );
);


// ==================================================
// ACTIVE SAMPLE RANGE
// ==================================================

range_start_x = wave_x + range_start * wave_w;
range_end_x = wave_x + range_end * wave_w;

// Dim the waveform outside the selected range.
gfx_set(0.02, 0.02, 0.025, 0.78);
gfx_rect(
    wave_x,
    wave_y,
    max(0, range_start_x - wave_x),
    wave_h
);
gfx_rect(
    range_end_x,
    wave_y,
    max(0, wave_x + wave_w - range_end_x),
    wave_h
);

// Range boundary markers.
gfx_set(0.25, 0.85, 1.0, 1);
gfx_line(range_start_x, wave_y, range_start_x, wave_y + wave_h);
gfx_line(range_end_x, wave_y, range_end_x, wave_y + wave_h);


// ==================================================
// ANIMATED GRAIN MARKERS
// ==================================================

frame_count > 1 ? (

    i = 0;

    loop(
        max_grains,

        active_base[i] ? (

            // Current source position of this grain
            grain_current_pos =
                start_base[i] +
                phase_base[i] *
                step_base[i];

            grain_marker_pos =
                grain_current_pos /
                frame_count;

            grain_marker_pos =
                max(
                    0,
                    min(
                        1,
                        grain_marker_pos
                    )
                );

            grain_marker_x =
                wave_x +
                grain_marker_pos *
                wave_w;


            // --------------------------------------
            // Grain progress 0..1
            // --------------------------------------

            grain_progress =
                phase_base[i] /
                max(
                    1,
                    length_base[i]
                );

            grain_progress =
                max(
                    0,
                    min(
                        1,
                        grain_progress
                    )
                );


            // --------------------------------------
            // Marker brightness follows grain life
            // --------------------------------------

            marker_alpha =
                0.25 +
                0.75 *
                (
                    1 -
                    grain_progress
                );


            gfx_set(
                1.0,
                0.65,
                0.20,
                marker_alpha
            );


            gfx_line(
                grain_marker_x,
                wave_y + 10,
                grain_marker_x,
                wave_y + wave_h - 10
            );


            // --------------------------------------
            // Small dot at center line
            // --------------------------------------

            gfx_circle(
                grain_marker_x,
                wave_y + wave_h * 0.5,
                3,
                1
            );
        );


        i += 1;
    );
);


// ==================================================
// MAIN POSITION MARKER
// ==================================================

position_x =
    wave_x +
    grain_position *
    wave_w;

gfx_set(
    0.35,
    1.0,
    0.45,
    1
);

gfx_line(
    position_x,
    wave_y,
    position_x,
    wave_y + wave_h
);

gfx_triangle(
    position_x - 7,
    wave_y,

    position_x + 7,
    wave_y,

    position_x,
    wave_y + 10
);


// ==================================================
// WAVEFORM HOVER FEEDBACK
// ==================================================

mouse_inside_wave ? (

    gfx_set(
        1.0,
        1.0,
        1.0,
        0.10
    );

    gfx_line(
        mouse_x,
        wave_y,
        mouse_x,
        wave_y + wave_h
    );
);


// --------------------------------------------------
// WAVEFORM BORDER
// --------------------------------------------------

gfx_set(
    0.35,
    0.35,
    0.40,
    1
);

gfx_rect(
    wave_x,
    wave_y,
    wave_w,
    wave_h,
    0
);


// ==================================================
// POSITION TEXT
// ==================================================

gfx_set(
    0.85,
    0.85,
    0.85,
    1
);

gfx_x = 30;
gfx_y = 300;

gfx_drawstr(
    "Position: "
);

gfx_drawnumber(
    grain_position * 100,
    1
);

gfx_drawstr(
    "%"
);


// ==================================================
// ENGINE INFORMATION
// ==================================================

gfx_x = 30;
gfx_y = 335;

gfx_drawstr(
    "Sample: "
);

gfx_drawnumber(
    frame_count,
    0
);

gfx_drawstr(
    " frames"
);


gfx_x = 30;
gfx_y = 360;

gfx_drawstr(
    "Sample rate: "
);

gfx_drawnumber(
    sample_samplerate,
    0
);

gfx_drawstr(
    " Hz"
);


gfx_x = 30;
