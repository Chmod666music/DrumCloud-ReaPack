@init

version = 0.26;

function valid_number(value)
(
    value == value && abs(value) < 100000000000000000000;
);

function mono_sample_at(frame)
local(index)
(
    frame = max(0, min(frame_count - 1, floor(frame)));
    sample_channels == 1 ? (
        sample_buffer[frame];
    ) : (
        index = frame * sample_channels;
        (sample_buffer[index] + sample_buffer[index + 1]) * 0.5;
    );
);

// Mean-subtracted normalized autocorrelation, shared by search and refinement.
function root_correlation(start, count, lag)
local(i, a, b, sa, sb, cross, ea, eb)
(
    i = sa = sb = cross = ea = eb = 0;
    loop(count,
        a = mono_sample_at(start + i);
        b = mono_sample_at(start + i + lag);
        sa += a; sb += b; cross += a*b; ea += a*a; eb += b*b;
        i += 1;
    );
    cross -= sa*sb/count;
    ea = max(0, ea-sa*sa/count);
    eb = max(0, eb-sb*sb/count);
    cross / max(0.000000000001, sqrt(ea*eb));
);

// Analyze only on explicit request; never modify playback parameters here.
// Prefer the earliest near-best local peak to avoid choosing integer multiples
// of the fundamental period. Interpolate that peak before converting to cents.
function analyze_loaded_root()
local(region_i, region_center, region_start, window_frames, min_lag, max_lag,
      lag, score, best_score, best_lag, region_midi, midi_sum, score_sum,
      valid_regions, low_midi, high_midi, left, middle, right, denominator,
      fractional_lag, offset, mean_midi)
(
    detected_root_note = -1;
    detected_cents = detected_confidence = 0;
    analysis_status = 2;
    frame_count > 4096 && sample_samplerate > 0 ? (
        window_frames = min(3072, floor(frame_count * 0.16));
        min_lag = max(8, floor(sample_samplerate / 1000));
        max_lag = min(floor(sample_samplerate / 45), window_frames - 16);
        midi_sum = score_sum = valid_regions = region_i = 0;
        low_midi = 1000; high_midi = -1000;
        loop(3,
            region_center = (0.25 + region_i * 0.25) * (frame_count - 1);
            region_start = floor(max(0, min(frame_count-window_frames-max_lag-2,
                                            region_center-window_frames*0.5)));
            best_score = -1; best_lag = 0;
            left = root_correlation(region_start, window_frames, min_lag);
            middle = root_correlation(region_start, window_frames, min_lag+1);
            lag = min_lag+2;
            loop(max(0, max_lag-min_lag-1),
                right = root_correlation(region_start, window_frames, lag);
                middle > left && middle >= right && middle > best_score+0.01 ? (
                    best_score = middle; best_lag = lag-1;
                );
                left = middle; middle = right; lag += 1;
            );
            best_lag > 0 && best_score > 0.45 ? (
                left = root_correlation(region_start, window_frames, best_lag-1);
                middle = root_correlation(region_start, window_frames, best_lag);
                right = root_correlation(region_start, window_frames, best_lag+1);
                denominator = left-2*middle+right;
                offset = abs(denominator) > 0.000000000001 ?
                    max(-0.5, min(0.5, 0.5*(left-right)/denominator)) : 0;
                fractional_lag = best_lag+offset;
                region_midi = 69+12*log(sample_samplerate/fractional_lag/440)/log(2);
                low_midi = min(low_midi, region_midi);
                high_midi = max(high_midi, region_midi);
                midi_sum += region_midi; score_sum += best_score; valid_regions += 1;
            );
            region_i += 1;
        );
        valid_regions == 3 ? (
            mean_midi = midi_sum/3;
            detected_confidence = max(0, min(1, score_sum/3));
            detected_root_note = floor(mean_midi+0.5);
            detected_cents = (mean_midi-detected_root_note)*100;
            // Cents application needs closer agreement than the old 1.25 semitones.
            detected_confidence >= 0.72 && high_midi-low_midi <= 0.30 &&
            detected_root_note >= 0 && detected_root_note <= 127 ? analysis_status = 1;
        );
    );
);

// ==================================================
// FACTORY SAMPLE ROOT MAP
// ==================================================

function recommended_root_for_sample(filename)
local(root)
(
    // -1 means intentionally unmapped. Existing preset/root values remain.
    root = -1;
match("*850842*", filename) ? root = 31;
    match("*850843*", filename) ? root = 40;
    match("*850844*", filename) ? root = 48;
