// ==================================================
// MEMORY LAYOUT
// ==================================================

max_grains = 32;
max_voices = 8;

active_base    = 0;
phase_base     = 32;
start_base     = 64;
step_base      = 96;
length_base    = 128;
velocity_base  = 160;
pan_base       = 192;
retire_base    = 320;
last_l_base    = 352;
last_r_base    = 384;

// Eight MIDI voices share the grain pool. A voice owns only note state and
// a scheduler; spawned grains retain their own pitch/velocity until finished.
voice_active_base   = 256;
voice_note_base     = 264;
voice_velocity_base = 272;
voice_step_base     = 280;
voice_spawn_base    = 288;
voice_age_base      = 296;
voice_channel_base  = 304;

// Fixed reverb memory stays below the dynamically loaded sample.
reverb_max_delay = 65536;
allpass_max_delay = 16384;

comb_l1_base = 1024;
comb_l2_base = comb_l1_base + reverb_max_delay;
comb_l3_base = comb_l2_base + reverb_max_delay;
comb_l4_base = comb_l3_base + reverb_max_delay;
comb_r1_base = comb_l4_base + reverb_max_delay;
comb_r2_base = comb_r1_base + reverb_max_delay;
comb_r3_base = comb_r2_base + reverb_max_delay;
comb_r4_base = comb_r3_base + reverb_max_delay;

allpass_l1_base = comb_r4_base + reverb_max_delay;
allpass_l2_base = allpass_l1_base + allpass_max_delay;
allpass_r1_base = allpass_l2_base + allpass_max_delay;
allpass_r2_base = allpass_r1_base + allpass_max_delay;

shimmer_max_delay = 32768;
shimmer_l_base = allpass_r2_base + allpass_max_delay;
shimmer_r_base = shimmer_l_base + shimmer_max_delay;

reverb_memory_end =
    shimmer_r_base +
    shimmer_max_delay;

delay_max_samples = 524288;
delay_l_base = reverb_memory_end;
delay_r_base = delay_l_base + delay_max_samples;
effects_memory_end = delay_r_base + delay_max_samples;

sample_buffer = 2097152;

reverb_write_pos = 0;
allpass_write_pos = 0;
shimmer_write_pos = 0;
shimmer_phase = 0;
shimmer_feedback_l = 0;
shimmer_feedback_r = 0;
last_reverb_mode = -1;

delay_write_pos = 0;
delay_l_damp = 0;
delay_r_damp = 0;
last_delay_mode = -1;

output_limiter_gain = 1;

comb_l1_damp = 0;
comb_l2_damp = 0;
comb_l3_damp = 0;
comb_l4_damp = 0;
comb_r1_damp = 0;
comb_r2_damp = 0;
comb_r3_damp = 0;
comb_r4_damp = 0;

// Clear all reverb delay memory on startup.
reverb_clear_index = 1024;
loop(
    reverb_memory_end - 1024,
    reverb_clear_index[0] = 0;
    reverb_clear_index += 1;
);

delay_clear_index = reverb_memory_end;
loop(
    effects_memory_end - reverb_memory_end,
    delay_clear_index[0] = 0;
    delay_clear_index += 1;
);


// ==================================================
// SAMPLE STATE
// ==================================================

sample_length = 0;
sample_channels = 0;
sample_samplerate = 0;
frame_count = 0;
scan_position = 0.5;
range_start = 0;
range_end = 1;
scan_direction = 1;
scan_random_counter = 0;
random_walk_direction = 0;
last_position_mode = 2;
last_scan_on = 0;

last_sample = -1;
sample_load_ok = 0;
last_auto_root = 0;
manual_root_note = root_note;
detect_root = apply_tuning = 0; // commands are never restored/armed on initialization
last_detect_root = 0;
last_apply_tuning = 0;
detected_cents = 0;
detected_root_note = -1;
detected_confidence = 0;
analysis_status = 0;
alternate_grain_direction = 0;


// ==================================================
// MIDI / CLOUD STATE
// ==================================================

active_voices = 0;
voice_age_counter = 0;

// GUI values follow the most recently triggered voice only. Audio generation
// always reads the independent per-voice state below.
current_note = -1;
pitch_ratio = 1;

active_grains = 0;


// ==================================================
// INITIAL CLEAR
// ==================================================

init_grain_i = 0;

loop(max_grains,

    active_base[init_grain_i] = 0;
    phase_base[init_grain_i] = 0;
    start_base[init_grain_i] = 0;
    step_base[init_grain_i] = 1;
    length_base[init_grain_i] = 1;
    velocity_base[init_grain_i] = 0;
    pan_base[init_grain_i] = 0;
    retire_base[init_grain_i] = 0;
    last_l_base[init_grain_i] = 0;
    last_r_base[init_grain_i] = 0;

    init_grain_i += 1;
);

init_voice_i = 0;

loop(max_voices,
    voice_active_base[init_voice_i] = 0;
    voice_note_base[init_voice_i] = -1;
    voice_velocity_base[init_voice_i] = 0;
    voice_step_base[init_voice_i] = 1;
    voice_spawn_base[init_voice_i] = 0;
    voice_age_base[init_voice_i] = 0;
    voice_channel_base[init_voice_i] = 0;
    init_voice_i += 1;
);


// ==================================================
// SLIDERS / SAMPLE LOADING
// ==================================================

@slider

output_gain =
    10 ^ (output_db / 20);

sample_selection_changed =
    slider1 != last_sample;

// Remember the user's/preset's root whenever Auto Root is not taking control.
!auto_root ? (
    manual_root_note = root_note;
);

auto_root_activated =
    auto_root &&
    !last_auto_root;

// Auto Root is opt-in. With its default Off state, loading legacy projects
// and presets preserves their saved Root MIDI note exactly.
auto_root &&
(
    sample_selection_changed ||
    auto_root_activated
) ? (
    strcpy_fromslider(
        #selected_sample_filename,
        slider1
    );

    recommended_root =
        recommended_root_for_sample(
            #selected_sample_filename
        );

    recommended_root >= 0 ? (
        root_note = recommended_root;
        slider_automate(root_note);
    ) : (
        // Unpitched material returns to the last manual or preset root rather
        // than inheriting the previous tonal sample's automatic root.
        root_note = manual_root_note;
        slider_automate(root_note);
    );
);

// Changing reverb structure starts with a clean, predictable room.
reverb_mode != last_reverb_mode ? (
    reverb_clear_index = 1024;

    loop(
        reverb_memory_end - 1024,
        reverb_clear_index[0] = 0;
        reverb_clear_index += 1;
    );

    reverb_write_pos = 0;
    allpass_write_pos = 0;
    shimmer_write_pos = 0;
    shimmer_phase = 0;
    shimmer_feedback_l = 0;
    shimmer_feedback_r = 0;

    comb_l1_damp = 0;
    comb_l2_damp = 0;
    comb_l3_damp = 0;
    comb_l4_damp = 0;
    comb_r1_damp = 0;
    comb_r2_damp = 0;
    comb_r3_damp = 0;
    comb_r4_damp = 0;

    last_reverb_mode = reverb_mode;
);

size_scale =
    0.65 +
    reverb_size *
    1.35;

reverb_mode == 1 ? (
    delay_ms_1 = 17.3;
    delay_ms_2 = 23.1;
    delay_ms_3 = 31.7;
    delay_ms_4 = 37.9;
    allpass_ms_1 = 4.7;
    allpass_ms_2 = 1.7;
) : (
    delay_ms_1 = 29.7;
    delay_ms_2 = 37.1;
    delay_ms_3 = 41.1;
    delay_ms_4 = 43.7;
    allpass_ms_1 = 7.1;
    allpass_ms_2 = 2.3;
);

delay_l1 = max(1, min(reverb_max_delay - 1, floor(delay_ms_1 * 0.001 * srate * size_scale)));
delay_l2 = max(1, min(reverb_max_delay - 1, floor(delay_ms_2 * 0.001 * srate * size_scale)));
delay_l3 = max(1, min(reverb_max_delay - 1, floor(delay_ms_3 * 0.001 * srate * size_scale)));
delay_l4 = max(1, min(reverb_max_delay - 1, floor(delay_ms_4 * 0.001 * srate * size_scale)));

stereo_offset =
    max(
        1,
        floor(1.1 * 0.001 * srate)
    );

delay_r1 = max(1, min(reverb_max_delay - 1, delay_l1 + stereo_offset));
delay_r2 = max(1, min(reverb_max_delay - 1, delay_l2 + stereo_offset));
delay_r3 = max(1, min(reverb_max_delay - 1, delay_l3 + stereo_offset));
delay_r4 = max(1, min(reverb_max_delay - 1, delay_l4 + stereo_offset));

decay_seconds = max(0.1, reverb_decay);

// Shimmer has a second feedback path and therefore needs more headroom.
feedback_ceiling =
    reverb_mode == 3 ?
    0.90 :
    0.975;

feedback_l1 = min(feedback_ceiling, 10 ^ (-3 * delay_l1 / (srate * decay_seconds)));
feedback_l2 = min(feedback_ceiling, 10 ^ (-3 * delay_l2 / (srate * decay_seconds)));
feedback_l3 = min(feedback_ceiling, 10 ^ (-3 * delay_l3 / (srate * decay_seconds)));
feedback_l4 = min(feedback_ceiling, 10 ^ (-3 * delay_l4 / (srate * decay_seconds)));
feedback_r1 = min(feedback_ceiling, 10 ^ (-3 * delay_r1 / (srate * decay_seconds)));
feedback_r2 = min(feedback_ceiling, 10 ^ (-3 * delay_r2 / (srate * decay_seconds)));
feedback_r3 = min(feedback_ceiling, 10 ^ (-3 * delay_r3 / (srate * decay_seconds)));
feedback_r4 = min(feedback_ceiling, 10 ^ (-3 * delay_r4 / (srate * decay_seconds)));

damping_coefficient =
    max(
        0.02,
        1 -
        reverb_damping *
        0.98
    );

allpass_delay_l1 = max(1, min(allpass_max_delay - 1, floor(allpass_ms_1 * 0.001 * srate * size_scale)));
allpass_delay_l2 = max(1, min(allpass_max_delay - 1, floor(allpass_ms_2 * 0.001 * srate * size_scale)));
allpass_delay_r1 = max(1, min(allpass_max_delay - 1, allpass_delay_l1 + stereo_offset));
allpass_delay_r2 = max(1, min(allpass_max_delay - 1, allpass_delay_l2 + stereo_offset));

shimmer_window_frames =
    max(
        256,
        min(
            shimmer_max_delay - 64,
            floor(0.08 * srate)
        )
    );

shimmer_phase_increment =
    1 /
    shimmer_window_frames;

output_limiter_release =
    1 -
    exp(
        -1 /
        max(
            1,
            0.10 * srate
        )
    );

delay_mode != last_delay_mode ? (
    delay_clear_index = reverb_memory_end;

    loop(
        effects_memory_end - reverb_memory_end,
        delay_clear_index[0] = 0;
        delay_clear_index += 1;
    );

    delay_write_pos = 0;
    delay_l_damp = 0;
    delay_r_damp = 0;
    last_delay_mode = delay_mode;
);

delay_samples_l =
    max(
        1,
        min(
            delay_max_samples - 1,
            floor(
                delay_time_l_ms *
                0.001 *
                srate
            )
        )
    );

delay_samples_r =
    max(
        1,
        min(
            delay_max_samples - 1,
            floor(
                delay_time_r_ms *
                0.001 *
                srate
            )
        )
    );

delay_damping_coefficient =
    max(
        0.02,
        1 -
        delay_damping *
        0.98
    );

// Keep a valid range even if the automation lanes cross.
range_start = min(sample_start, sample_end);
range_end = max(sample_start, sample_end);

range_end - range_start < 0.001 ? (
    range_end = min(1, range_start + 0.001);
    range_end - range_start < 0.001 ? (
        range_start = max(0, range_end - 0.001);
    );
);

grain_position = max(range_start, min(range_end, grain_position));
scan_position = max(range_start, min(range_end, scan_position));

scan_on && !last_scan_on ? (
    scan_position = grain_position;
    scan_direction = 1;
    scan_random_counter = 0;
);

position_mode != last_position_mode ? (
    scan_direction = 1;
    scan_random_counter = 0;
    last_position_mode = position_mode;
);

!scan_on ? (
    scan_position = grain_position;
);

last_scan_on = scan_on;


slider1 != last_sample ? (

    // Invalidate stale analysis even when loading fails.
    analysis_status = 0;
    detected_root_note = -1;
    detected_cents = detected_confidence = 0;
    sample_load_ok = 0;
    handle = file_open(slider1);

    handle >= 0 ? (

        file_riff(
            handle,
            sample_channels,
            sample_samplerate
        );

        sample_length =
            file_avail(handle);

        sample_length > 0 ? (

            file_mem(
                handle,
                sample_buffer,
                sample_length
            );
        );

        file_close(handle);


        sample_channels > 0 ? (

            frame_count =
                sample_length /
                sample_channels;
        );


        sample_load_ok = frame_count > 0 && sample_samplerate > 0;

        // Stop existing grains
        load_grain_i = 0;

        loop(max_grains,

            active_base[load_grain_i] = 0;
            retire_base[load_grain_i] = 0;
            last_l_base[load_grain_i] = 0;
            last_r_base[load_grain_i] = 0;

            load_grain_i += 1;
        );

        active_grains = 0;
        detected_root_note = -1;
        detected_confidence = 0;
        analysis_status = 0;

        // A newly loaded sample starts from a clean MIDI state.
        load_voice_i = 0;
        loop(max_voices,
            voice_active_base[load_voice_i] = 0;
            voice_note_base[load_voice_i] = -1;
            voice_velocity_base[load_voice_i] = 0;
            voice_spawn_base[load_voice_i] = 0;
            voice_channel_base[load_voice_i] = 0;
            load_voice_i += 1;
        );
        active_voices = 0;
        current_note = -1;
    );

    last_sample = slider1;
);

// Analyze only on the rising edge, after a newly selected file has loaded.
detect_root && !last_detect_root ? (
    analysis_status = 3;
    sample_load_ok ? analyze_loaded_root() : analysis_status = 2;
);
// Momentary commands cannot remain armed in newly saved states.
detect_root = 0;
sliderchange(slider32);
last_detect_root = detect_root;
apply_tuning && !last_apply_tuning ? (
    (analysis_status == 1 || analysis_status == 4) ? (
        root_note = detected_root_note;
        manual_root_note = root_note;
        slider_automate(slider2);
        apply_tuning == 2 ? (
            // Measured source offset and playback correction have opposite signs.
            fine_tune = -detected_cents;
            slider_automate(slider33);
        );
        analysis_status = 4;
    );
);
apply_tuning = 0;
sliderchange(slider34);
last_apply_tuning = apply_tuning;

last_auto_root = auto_root;


// ==================================================
// MIDI
// ==================================================

@block

while (
    midirecv(offset, msg1, msg23) ?

    (

        status =
            msg1 & $xF0;

        midi_channel =
            msg1 & $x0F;

        note =
            msg23 & $x7F;

        velocity =
            (msg23 / 256) & $x7F;


        // ------------------------------------------
        // NOTE ON
        // ------------------------------------------

        status == $x90 &&
        velocity > 0 ? (

            // Prefer a free voice. If all eight are busy, steal the oldest.
            chosen_voice = -1;
            oldest_voice = 0;
            oldest_age = voice_age_base[0];
            midi_alloc_i = 0;

            loop(max_voices,
                chosen_voice < 0 && !voice_active_base[midi_alloc_i] ? (
                    chosen_voice = midi_alloc_i;
                );
                voice_age_base[midi_alloc_i] < oldest_age ? (
                    oldest_age = voice_age_base[midi_alloc_i];
                    oldest_voice = midi_alloc_i;
                );
                midi_alloc_i += 1;
            );

            chosen_voice < 0 ? chosen_voice = oldest_voice;

            voice_age_counter += 1;
            voice_active_base[chosen_voice] = 1;
            voice_note_base[chosen_voice] = note;
            voice_channel_base[chosen_voice] = midi_channel;
            voice_velocity_base[chosen_voice] = velocity / 127;
            voice_age_base[chosen_voice] = voice_age_counter;

            pitch_ratio = 2 ^ ((note - root_note) / 12);
            voice_step_base[chosen_voice] =
                pitch_ratio * (sample_samplerate / srate);

            voice_spawn_base[chosen_voice] = 0;
            current_note = note;
        );


        // ------------------------------------------
        // NOTE OFF
        // ------------------------------------------

        (
            status == $x80
        )
        ||
        (
            status == $x90 &&
            velocity == 0
        ) ? (

            // Release only the oldest active occurrence of this exact note
            // and channel. Every unrelated held note remains active.
            release_voice = -1;
            release_age = voice_age_counter + 1;
            midi_release_i = 0;

            loop(max_voices,
                voice_active_base[midi_release_i] &&
                voice_note_base[midi_release_i] == note &&
                voice_channel_base[midi_release_i] == midi_channel &&
                voice_age_base[midi_release_i] < release_age ? (
                    release_voice = midi_release_i;
                    release_age = voice_age_base[midi_release_i];
                );
                midi_release_i += 1;
            );

            release_voice >= 0 ? (
                voice_active_base[release_voice] = 0;
                voice_velocity_base[release_voice] = 0;

                current_note = -1;
                newest_age = -1;
                midi_newest_i = 0;
                loop(max_voices,
                    voice_active_base[midi_newest_i] &&
                    voice_age_base[midi_newest_i] > newest_age ? (
                        newest_age = voice_age_base[midi_newest_i];
                        current_note = voice_note_base[midi_newest_i];
                        pitch_ratio =
                            voice_step_base[midi_newest_i] /
                            max(0.000001, sample_samplerate / srate);
                    );
                    midi_newest_i += 1;
                );
            );
        );

        // MIDI All Sound Off and All Notes Off stop schedulers only on the
        // addressed channel; already spawned grains finish their envelopes.
        status == $xB0 &&
        (note == 120 || note == 123) ? (
            midi_alloff_i = 0;
            loop(max_voices,
                voice_active_base[midi_alloff_i] &&
                voice_channel_base[midi_alloff_i] == midi_channel ? (
                    voice_active_base[midi_alloff_i] = 0;
                    voice_velocity_base[midi_alloff_i] = 0;
                );
                midi_alloff_i += 1;
            );
        );


        1;
    );
);


// ==================================================
// AUDIO
// ==================================================

@sample

out_l = 0;
out_r = 0;

// ==================================================
// POSITION MODES
// ==================================================

scan_on && frame_count > 1 ? (

    // Forward: always move right and wrap at the end.
    position_mode == 0 ? (
        scan_position += abs(scan_speed) / srate;
        scan_position >= range_end ? (
            scan_position = range_start + (scan_position - range_end);
        );
    );

    // Backward: always move left and wrap at the start.
    position_mode == 1 ? (
        scan_position -= abs(scan_speed) / srate;
        scan_position < range_start ? (
            scan_position = range_end - (range_start - scan_position);
        );
    );

    // Ping Pong: reflect naturally at both ends.
    position_mode == 2 ? (
        scan_position +=
            scan_speed *
            scan_direction /
            srate;

        scan_position > range_end ? (
            scan_position = 2 * range_end - scan_position;
            scan_direction = -scan_direction;
        );

        scan_position < range_start ? (
            scan_position = 2 * range_start - scan_position;
            scan_direction = -scan_direction;
        );
    );

    // Random Jump: Scan Speed controls jumps per second.
    position_mode == 3 && abs(scan_speed) > 0 ? (
        scan_random_counter <= 0 ? (
            scan_position =
                range_start +
                rand(1) *
                (range_end - range_start);
            scan_random_counter =
                srate /
                max(
                    0.01,
                    abs(scan_speed)
                );
        );

        scan_random_counter -= 1;
    );

    // Random Walk: choose a new drift direction four times per second.
    position_mode == 4 && abs(scan_speed) > 0 ? (
        scan_random_counter <= 0 ? (
            random_walk_direction = rand(2) - 1;
            scan_random_counter = srate * 0.25;
        );

        scan_random_counter -= 1;

        scan_position +=
            random_walk_direction *
            abs(scan_speed) /
            srate;

        scan_position > range_end ? (
            scan_position = 2 * range_end - scan_position;
            random_walk_direction = -abs(random_walk_direction);
        );

        scan_position < range_start ? (
            scan_position = 2 * range_start - scan_position;
            random_walk_direction = abs(random_walk_direction);
        );
    );

    scan_position = max(range_start, min(range_end, scan_position));

    grain_position =
        scan_position;
);


// ==================================================
// SPAWN GRAINS
// ==================================================

active_voices = 0;
voice_index = 0;

loop(max_voices,

voice_active_base[voice_index] &&
frame_count > 1 ? (

    active_voices += 1;

    voice_spawn_base[voice_index] <= 0 ? (

        free_grain = -1;

        spawn_search_i = 0;


        loop(max_grains,

            free_grain < 0 &&
            active_base[spawn_search_i] == 0 ? (

                free_grain = spawn_search_i;
            );

            spawn_search_i += 1;
        );


        // ------------------------------------------
        // CREATE GRAIN
        // ------------------------------------------

        free_grain >= 0 ? (

            // Give each grain an independent detune around the MIDI pitch.
            grain_detune =
                pitch_spread > 0 ?
                (
                    (rand(2) - 1) *
                    pitch_spread
                ) :
                0;

            grain_pitch_ratio =
                2 ^
                (
                    (grain_detune + fine_tune / 100) /
                    12
                );

            grain_step =
                voice_step_base[voice_index] *
                grain_pitch_ratio;

            // Direction belongs to the spawned grain, never to the scan head.
            grain_play_backward = 0;
            grain_direction == 1 ? grain_play_backward = 1;
            grain_direction == 2 ? (
                grain_play_backward = alternate_grain_direction;
            );
            grain_direction == 3 ? grain_play_backward = rand(1) >= 0.5;
            grain_step_abs = abs(grain_step);
            grain_play_backward ? grain_step = -grain_step_abs : grain_step = grain_step_abs;

            grain_frames = floor(max(1, grain_size_ms * 0.001 * srate));

            range_start_frame =
                range_start *
                (frame_count - 1);

            range_end_frame =
                range_end *
                (frame_count - 1);

            // Reserve the following frame for interpolation. Using integer
            // read limits prevents interpolation from crossing either range
            // boundary even when the sliders resolve to fractional frames.
            safe_start_frame = ceil(range_start_frame);
            safe_end_frame = floor(range_end_frame) - 1;

            safe_source_length =
                safe_end_frame - safe_start_frame;

            // Short ranges shorten grains so playback stays in range.
            max_grain_frames =
                floor(
                    safe_source_length /
                    max(0.000001, grain_step_abs)
                ) + 1;

            grain_frames = min(grain_frames, max_grain_frames);

            grain_source_length =
                max(0, grain_frames - 1) *
                grain_step_abs;

            range_max_start =
                safe_end_frame - grain_source_length;


        // --------------------------------------
        // POSITION SPREAD
        // --------------------------------------

        random_offset =
            (rand(2) - 1) *
            position_spread;

        // Spread is relative to whole sample
        spread_position =
            grain_position +
            random_offset;

        // Keep every grain inside the selected sample range.
        spread_position =
            max(
                range_start,
                min(
                    range_end,
                    spread_position
                )
            );

        range_position =
            (spread_position - range_start) /
            max(0.001, range_end - range_start);

        grain_play_backward ? (
            // Backward grains begin toward the right edge and finish toward
            // the left, while retaining the same position-spread mapping.
            grain_start =
                safe_start_frame + grain_source_length +
                range_position *
                (safe_end_frame - (safe_start_frame + grain_source_length));
        ) : (
            grain_start =
                safe_start_frame +
                range_position *
                (range_max_start - safe_start_frame);
        );

            grain_final_source =
                grain_start +
                max(0, grain_frames - 1) * grain_step;


            // RANDOM PAN
            grain_pan =
                (
                    rand(2) - 1
                )
                *
                stereo_spread;


            // Validate every derived value before touching the shared slot.
            // Activation is the final atomic commit, so @gfx and @sample can
            // never observe a partially initialized grain.
            grain_valid =
                safe_end_frame >= safe_start_frame &&
                valid_number(grain_start) &&
                valid_number(grain_step) &&
                valid_number(grain_frames) &&
                valid_number(grain_final_source) &&
                abs(grain_step) > 0 &&
                grain_frames >= 1 &&
                grain_start >= safe_start_frame &&
                grain_start <= safe_end_frame &&
                grain_final_source >= safe_start_frame &&
                grain_final_source <= safe_end_frame &&
                safe_start_frame >= 0 &&
                safe_end_frame + 1 < frame_count;

            grain_valid ? (
                grain_direction == 2 ? (
                    alternate_grain_direction = 1 - alternate_grain_direction;
                );
                phase_base[free_grain] = 0;
                start_base[free_grain] = grain_start;
                step_base[free_grain] = grain_step;
                length_base[free_grain] = grain_frames;
                velocity_base[free_grain] = voice_velocity_base[voice_index];
                pan_base[free_grain] = grain_pan;
                retire_base[free_grain] = 0;
                last_l_base[free_grain] = 0;
                last_r_base[free_grain] = 0;
                active_base[free_grain] = 1;
            );
        );


        // ------------------------------------------
        // NEXT GRAIN
        // ------------------------------------------

        // A full pool retries on the next sample; no slot or scheduler state
        // is partially consumed. Invalid range/math waits one normal interval.
        free_grain < 0 ? (
            voice_spawn_base[voice_index] = 1;
        ) : (
            nominal_spawn_interval = srate / max(0.1, density);
            density_spread > 0 ? (
                spawn_variation = 1 + (rand(2) - 1) * density_spread * 0.75;
                voice_spawn_base[voice_index] =
                    max(64, nominal_spawn_interval * max(0.25, spawn_variation));
            ) : (
                // Bit-for-bit scheduling behavior for legacy presets.
                voice_spawn_base[voice_index] = nominal_spawn_interval;
            );
        );
    );


    voice_spawn_base[voice_index] -= 1;
);

voice_index += 1;
);


// ==================================================
// PROCESS ACTIVE GRAINS
// ==================================================

active_grains = 0;

audio_grain_i = 0;


loop(max_grains,

    active_base[audio_grain_i] ? (

        grain_phase =
            phase_base[audio_grain_i];

        grain_length =
            length_base[audio_grain_i];

        grain_step =
            step_base[audio_grain_i];

        grain_pan =
            pan_base[audio_grain_i];


        source_pos =
            start_base[audio_grain_i] +
            grain_phase *
            grain_step;

        // Re-evaluate the currently selected range for every sample. This
        // immediately retires grains from an old range after a preset load or
        // Sample Start/End edit instead of letting them read outside it.
        current_range_start_frame =
            range_start *
            (frame_count - 1);

        current_range_end_frame =
            range_end *
            (frame_count - 1);


        (
            grain_phase <
            grain_length
        )
        &&
        (
            source_pos <
            frame_count - 1
        )
        &&
        (
            source_pos >=
            current_range_start_frame
        )
        &&
        (
            source_pos + 1 <=
            floor(current_range_end_frame)
        )
        &&
        (
            valid_number(source_pos) &&
            valid_number(grain_step) &&
            abs(grain_step) > 0
        ) ? (


            // --------------------------------------
            // INTERPOLATION
            // --------------------------------------

            frame_int =
                floor(
                    source_pos
                );


            frac =
                source_pos -
                frame_int;


            next_frame =
                min(
                    frame_int + 1,
                    frame_count - 1
                );


            // --------------------------------------
            // MONO
            // --------------------------------------

            sample_channels == 1 ? (

                s1 =
                    sample_buffer[
                        frame_int
                    ];

                s2 =
                    sample_buffer[
                        next_frame
                    ];


                grain_l =
                    s1 +
                    (
                        s2 - s1
                    ) *
                    frac;


                grain_r =
                    grain_l;

            ) : (


                // ----------------------------------
                // STEREO
                // ----------------------------------

                idx1 =
                    frame_int *
                    sample_channels;


                idx2 =
                    next_frame *
                    sample_channels;


                l1 =
                    sample_buffer[
                        idx1
                    ];

                l2 =
                    sample_buffer[
                        idx2
                    ];

                r1 =
                    sample_buffer[
                        idx1 + 1
                    ];

                r2 =
                    sample_buffer[
                        idx2 + 1
                    ];


                grain_l =
                    l1 +
                    (
                        l2 - l1
                    ) *
                    frac;


                grain_r =
                    r1 +
                    (
                        r2 - r1
                    ) *
                    frac;
            );


            // --------------------------------------
            // ADJUSTABLE ATTACK / RELEASE ENVELOPE
            // --------------------------------------

            available_env_frames =
                max(
                    1,
                    grain_length - 1
                );

            attack_frames =
                max(
                    0,
                    attack_ms *
                    0.001 *
                    srate
                );

            release_frames =
                max(
                    0,
                    release_ms *
                    0.001 *
                    srate
                );

            envelope_frames =
                attack_frames +
                release_frames;

            // Scale both stages proportionally when the grain is too short.
            envelope_frames > available_env_frames ? (
                envelope_scale =
                    available_env_frames /
                    max(
                        0.000001,
                        envelope_frames
                    );

                attack_frames *= envelope_scale;
                release_frames *= envelope_scale;
            );

            grain_env = 1;

            attack_frames > 0 &&
            grain_phase < attack_frames ? (
                attack_progress =
                    max(
                        0,
                        min(
                            1,
                            grain_phase /
                            attack_frames
                        )
                    );

                grain_env =
                    0.5 -
                    0.5 *
                    cos(
                        $pi *
                        attack_progress
                    );
            );

            release_frames > 0 &&
            grain_phase > available_env_frames - release_frames ? (
                release_progress =
                    max(
                        0,
                        min(
                            1,
                            (
                                available_env_frames -
                                grain_phase
                            ) /
                            release_frames
                        )
                    );

                release_env =
                    0.5 -
                    0.5 *
                    cos(
                        $pi *
                        release_progress
                    );

                grain_env =
                    min(
                        grain_env,
                        release_env
                    );
            );


            // --------------------------------------
            // EQUAL POWER PAN
            // --------------------------------------

            pan_l =
                sqrt(
                    0.5 *
                    (
                        1 -
                        grain_pan
                    )
                );


            pan_r =
                sqrt(
                    0.5 *
                    (
                        1 +
                        grain_pan
                    )
                );


            grain_gain =
                grain_env *
                velocity_base[audio_grain_i];


            grain_l *=
                grain_gain *
                pan_l;


            grain_r *=
                grain_gain *
                pan_r;


            // --------------------------------------
            // MIX
            // --------------------------------------

            out_l += grain_l;
            out_r += grain_r;

            last_l_base[audio_grain_i] = grain_l;
            last_r_base[audio_grain_i] = grain_r;
            retire_base[audio_grain_i] = 0;


            phase_base[audio_grain_i] += 1;

            active_grains += 1;

        ) : (

            // Normal completion already reaches the configured release
            // envelope. Unexpected invalidation gets a tiny cached-sample
            // fade, preventing a discontinuity without any unsafe read.
            grain_phase >= grain_length ? (
                active_base[audio_grain_i] = 0;
                retire_base[audio_grain_i] = 0;
            ) : (
                retire_base[audio_grain_i] <= 0 ? (
                    retire_base[audio_grain_i] = 32;
                );

                retire_gain = retire_base[audio_grain_i] / 32;
                out_l += last_l_base[audio_grain_i] * retire_gain;
                out_r += last_r_base[audio_grain_i] * retire_gain;
                retire_base[audio_grain_i] -= 1;
                active_grains += 1;

                retire_base[audio_grain_i] <= 0 ? (
                    active_base[audio_grain_i] = 0;
                    last_l_base[audio_grain_i] = 0;
                    last_r_base[audio_grain_i] = 0;
                );
            );
        );
    );


    audio_grain_i += 1;
);


// ==================================================
// CLOUD NORMALIZATION
// ==================================================

cloud_gain =
    1 /
    sqrt(
        max(
            1,
            active_grains
        )
    );


out_l *= cloud_gain;
out_r *= cloud_gain;


// ==================================================
// STEREO CLOUD REVERB
// ==================================================

reverb_mode > 0 ? (

    dry_l = out_l;
    dry_r = out_r;

    reverb_input_l =
        (
            dry_l +
            dry_r * 0.15 +
            shimmer_feedback_l *
            shimmer_amount
        ) *
        0.70;

    reverb_input_r =
        (
            dry_r +
            dry_l * 0.15 +
            shimmer_feedback_r *
            shimmer_amount
        ) *
        0.70;

    read_l1 = (reverb_write_pos - delay_l1 + reverb_max_delay) % reverb_max_delay;
    read_l2 = (reverb_write_pos - delay_l2 + reverb_max_delay) % reverb_max_delay;
    read_l3 = (reverb_write_pos - delay_l3 + reverb_max_delay) % reverb_max_delay;
    read_l4 = (reverb_write_pos - delay_l4 + reverb_max_delay) % reverb_max_delay;
    read_r1 = (reverb_write_pos - delay_r1 + reverb_max_delay) % reverb_max_delay;
    read_r2 = (reverb_write_pos - delay_r2 + reverb_max_delay) % reverb_max_delay;
    read_r3 = (reverb_write_pos - delay_r3 + reverb_max_delay) % reverb_max_delay;
    read_r4 = (reverb_write_pos - delay_r4 + reverb_max_delay) % reverb_max_delay;

    comb_l1_out = comb_l1_base[read_l1];
    comb_l2_out = comb_l2_base[read_l2];
    comb_l3_out = comb_l3_base[read_l3];
    comb_l4_out = comb_l4_base[read_l4];
    comb_r1_out = comb_r1_base[read_r1];
    comb_r2_out = comb_r2_base[read_r2];
    comb_r3_out = comb_r3_base[read_r3];
    comb_r4_out = comb_r4_base[read_r4];

    comb_l1_damp += damping_coefficient * (comb_l1_out - comb_l1_damp);
    comb_l2_damp += damping_coefficient * (comb_l2_out - comb_l2_damp);
    comb_l3_damp += damping_coefficient * (comb_l3_out - comb_l3_damp);
    comb_l4_damp += damping_coefficient * (comb_l4_out - comb_l4_damp);
    comb_r1_damp += damping_coefficient * (comb_r1_out - comb_r1_damp);
    comb_r2_damp += damping_coefficient * (comb_r2_out - comb_r2_damp);
    comb_r3_damp += damping_coefficient * (comb_r3_out - comb_r3_damp);
    comb_r4_damp += damping_coefficient * (comb_r4_out - comb_r4_damp);

    comb_l1_base[reverb_write_pos] = reverb_input_l + comb_l1_damp * feedback_l1;
    comb_l2_base[reverb_write_pos] = reverb_input_l + comb_l2_damp * feedback_l2;
    comb_l3_base[reverb_write_pos] = reverb_input_l + comb_l3_damp * feedback_l3;
    comb_l4_base[reverb_write_pos] = reverb_input_l + comb_l4_damp * feedback_l4;
    comb_r1_base[reverb_write_pos] = reverb_input_r + comb_r1_damp * feedback_r1;
    comb_r2_base[reverb_write_pos] = reverb_input_r + comb_r2_damp * feedback_r2;
    comb_r3_base[reverb_write_pos] = reverb_input_r + comb_r3_damp * feedback_r3;
    comb_r4_base[reverb_write_pos] = reverb_input_r + comb_r4_damp * feedback_r4;

    wet_l =
        (
            comb_l1_out +
            comb_l2_out +
            comb_l3_out +
            comb_l4_out
        ) *
        0.25;

    wet_r =
        (
            comb_r1_out +
            comb_r2_out +
            comb_r3_out +
            comb_r4_out
        ) *
        0.25;

    reverb_write_pos =
        (reverb_write_pos + 1) %
        reverb_max_delay;

    ap_read_l1 = (allpass_write_pos - allpass_delay_l1 + allpass_max_delay) % allpass_max_delay;
    ap_read_l2 = (allpass_write_pos - allpass_delay_l2 + allpass_max_delay) % allpass_max_delay;
    ap_read_r1 = (allpass_write_pos - allpass_delay_r1 + allpass_max_delay) % allpass_max_delay;
    ap_read_r2 = (allpass_write_pos - allpass_delay_r2 + allpass_max_delay) % allpass_max_delay;

    ap_l1_delayed = allpass_l1_base[ap_read_l1];
    ap_l1_out = ap_l1_delayed - wet_l;
    allpass_l1_base[allpass_write_pos] = wet_l + ap_l1_delayed * 0.5;

    ap_l2_delayed = allpass_l2_base[ap_read_l2];
    ap_l2_out = ap_l2_delayed - ap_l1_out;
    allpass_l2_base[allpass_write_pos] = ap_l1_out + ap_l2_delayed * 0.5;

    ap_r1_delayed = allpass_r1_base[ap_read_r1];
    ap_r1_out = ap_r1_delayed - wet_r;
    allpass_r1_base[allpass_write_pos] = wet_r + ap_r1_delayed * 0.5;

    ap_r2_delayed = allpass_r2_base[ap_read_r2];
    ap_r2_out = ap_r2_delayed - ap_r1_out;
    allpass_r2_base[allpass_write_pos] = ap_r1_out + ap_r2_delayed * 0.5;

    allpass_write_pos =
        (allpass_write_pos + 1) %
        allpass_max_delay;

    // ----------------------------------------------
    // DUAL-HEAD OCTAVE-UP SHIMMER FEEDBACK
    // ----------------------------------------------

    reverb_mode == 3 ? (

        shimmer_head_1 = shimmer_phase;
        shimmer_head_2 = (shimmer_phase + 0.5) % 1;

        shimmer_delay_1 =
            32 +
            (1 - shimmer_head_1) *
            (shimmer_window_frames - 64);

        shimmer_delay_2 =
            32 +
            (1 - shimmer_head_2) *
            (shimmer_window_frames - 64);

        shimmer_read_1 =
            shimmer_write_pos -
            shimmer_delay_1;

        shimmer_read_2 =
            shimmer_write_pos -
            shimmer_delay_2;

        shimmer_read_1 < 0 ? shimmer_read_1 += shimmer_max_delay;
        shimmer_read_2 < 0 ? shimmer_read_2 += shimmer_max_delay;

        shimmer_index_1 = floor(shimmer_read_1);
        shimmer_index_2 = floor(shimmer_read_2);
        shimmer_next_1 = (shimmer_index_1 + 1) % shimmer_max_delay;
        shimmer_next_2 = (shimmer_index_2 + 1) % shimmer_max_delay;
        shimmer_frac_1 = shimmer_read_1 - shimmer_index_1;
        shimmer_frac_2 = shimmer_read_2 - shimmer_index_2;

        shimmer_l_head_1 =
            shimmer_l_base[shimmer_index_1] +
            (
                shimmer_l_base[shimmer_next_1] -
                shimmer_l_base[shimmer_index_1]
            ) *
            shimmer_frac_1;

        shimmer_l_head_2 =
            shimmer_l_base[shimmer_index_2] +
            (
                shimmer_l_base[shimmer_next_2] -
                shimmer_l_base[shimmer_index_2]
            ) *
            shimmer_frac_2;

        shimmer_r_head_1 =
            shimmer_r_base[shimmer_index_1] +
            (
                shimmer_r_base[shimmer_next_1] -
                shimmer_r_base[shimmer_index_1]
            ) *
            shimmer_frac_1;

        shimmer_r_head_2 =
            shimmer_r_base[shimmer_index_2] +
            (
                shimmer_r_base[shimmer_next_2] -
                shimmer_r_base[shimmer_index_2]
            ) *
            shimmer_frac_2;

        shimmer_weight_1 =
            sin(
                $pi *
                shimmer_head_1
            );

        shimmer_weight_2 =
            sin(
                $pi *
                shimmer_head_2
            );

        shimmer_weight_sum =
            max(
                0.000001,
                shimmer_weight_1 +
                shimmer_weight_2
            );

        shimmer_pitch_l =
            (
                shimmer_l_head_1 * shimmer_weight_1 +
                shimmer_l_head_2 * shimmer_weight_2
            ) /
            shimmer_weight_sum;

        shimmer_pitch_r =
            (
                shimmer_r_head_1 * shimmer_weight_1 +
                shimmer_r_head_2 * shimmer_weight_2
            ) /
            shimmer_weight_sum;

        shimmer_raw_l =
            shimmer_pitch_l +
            shimmer_pitch_r * 0.10;

        shimmer_raw_r =
            shimmer_pitch_r +
            shimmer_pitch_l * 0.10;

        // Bounded soft feedback: never exceeds +/-0.16 per channel.
        shimmer_feedback_l =
            shimmer_raw_l /
            (
                1 +
                abs(shimmer_raw_l)
            ) *
            0.16;

        shimmer_feedback_r =
            shimmer_raw_r /
            (
                1 +
                abs(shimmer_raw_r)
            ) *
            0.16;

        shimmer_l_base[shimmer_write_pos] = ap_l2_out;
        shimmer_r_base[shimmer_write_pos] = ap_r2_out;

        shimmer_write_pos =
            (shimmer_write_pos + 1) %
            shimmer_max_delay;

        shimmer_phase += shimmer_phase_increment;
        shimmer_phase >= 1 ? shimmer_phase -= 1;

    ) : (

        shimmer_feedback_l = 0;
        shimmer_feedback_r = 0;
    );

    dry_gain =
        cos(
            reverb_mix *
            $pi *
            0.5
        );

    wet_gain =
        sin(
            reverb_mix *
            $pi *
            0.5
        );

    out_l =
        dry_l * dry_gain +
        ap_l2_out * wet_gain;

    out_r =
        dry_r * dry_gain +
        ap_r2_out * wet_gain;
);


// ==================================================
// STEREO / PING PONG DELAY
// ==================================================

delay_mode > 0 ? (

    delay_dry_l = out_l;
    delay_dry_r = out_r;

    delay_read_l =
        (
            delay_write_pos -
            delay_samples_l +
            delay_max_samples
        ) %
        delay_max_samples;

    delay_read_r =
        (
            delay_write_pos -
            delay_samples_r +
            delay_max_samples
        ) %
        delay_max_samples;

    delay_tap_l = delay_l_base[delay_read_l];
    delay_tap_r = delay_r_base[delay_read_r];

    delay_l_damp +=
        delay_damping_coefficient *
        (
            delay_tap_l -
            delay_l_damp
        );

    delay_r_damp +=
        delay_damping_coefficient *
        (
            delay_tap_r -
            delay_r_damp
        );

    // Stereo feeds each channel back into itself.
    delay_mode == 1 ? (
        delay_feedback_l =
            delay_l_damp *
            delay_feedback;

        delay_feedback_r =
            delay_r_damp *
            delay_feedback;

    ) : (

        // Ping Pong crosses the feedback between left and right.
        delay_feedback_l =
            delay_r_damp *
            delay_feedback;

        delay_feedback_r =
            delay_l_damp *
            delay_feedback;
    );

    delay_l_base[delay_write_pos] =
        delay_dry_l +
        delay_feedback_l;

    delay_r_base[delay_write_pos] =
        delay_dry_r +
        delay_feedback_r;

    delay_write_pos =
        (delay_write_pos + 1) %
        delay_max_samples;

    delay_dry_gain =
        cos(
            delay_mix *
            $pi *
            0.5
        );

    delay_wet_gain =
        sin(
            delay_mix *
            $pi *
            0.5
        );

    out_l =
        delay_dry_l * delay_dry_gain +
        delay_l_damp * delay_wet_gain;

    out_r =
        delay_dry_r * delay_dry_gain +
        delay_r_damp * delay_wet_gain;
);


// ==================================================
// OUTPUT
// ==================================================

pre_output_l =
    out_l *
    output_gain;

pre_output_r =
    out_r *
    output_gain;

output_peak =
    max(
        abs(pre_output_l),
        abs(pre_output_r)
    );

limiter_target =
    output_peak > 0.98 ?
    0.98 /
    output_peak :
    1;

limiter_target < output_limiter_gain ? (
    // Instant attack catches feedback spikes before they reach the output.
    output_limiter_gain = limiter_target;
) : (
    // Smooth 100 ms recovery avoids abrupt volume pumping.
    output_limiter_gain +=
        (
            1 -
            output_limiter_gain
        ) *
        output_limiter_release;
);

spl0 =
    pre_output_l *
    output_limiter_gain;

spl1 =
    pre_output_r *
    output_limiter_gain;


// ==================================================
// GUI
// ==================================================

@gfx 1180 980

// ==================================================
// v0.27 REAKIT GUI
// ==================================================

// ReaKit's public dispatcher expects these per-frame input globals.
gfx_getchar();
mx = mouse_x; my = mouse_y;
LMB = mouse_cap & 1; RMB = mouse_cap & 2;
lmb_down = LMB && !dc_prev_lmb;
rmb_down = RMB && !dc_prev_rmb;
CTRL = mouse_cap & 4; SHIFT = mouse_cap & 8;
dc_now = time_precise();
dt = min(max(dc_now - dc_last_gfx_time, 1/240), 0.05);
dc_last_gfx_time = dc_now;
hv_speed = 11;
frame_wheel = mouse_wheel != dc_prev_wheel ? (mouse_wheel - dc_prev_wheel) / 120 : 0;

// Design coordinates scale uniformly, leaving intentional breathing room on
// unusually wide/tall FX windows.
dc_sc = min(gfx_w / 1180, gfx_h / 980);
dc_sc = max(0.55, dc_sc);
dc_ox = (gfx_w - 1180 * dc_sc) * 0.5;
dc_oy = (gfx_h - 980 * dc_sc) * 0.5;

// Cohesive charcoal/navy + gold palette.
dc_bg_r = 0.035; dc_bg_g = 0.043; dc_bg_b = 0.060;
dc_panel_r = 0.065; dc_panel_g = 0.075; dc_panel_b = 0.098;
dc_line_r = 0.145; dc_line_g = 0.160; dc_line_b = 0.195;
dc_text_r = 0.86; dc_text_g = 0.87; dc_text_b = 0.90;
dc_gold_r = 0.96; dc_gold_g = 0.70; dc_gold_b = 0.16;

gfx_set(dc_bg_r, dc_bg_g, dc_bg_b, 1);
gfx_rect(0, 0, gfx_w, gfx_h);

// Header.
gfx_setfont(1, "Arial", max(14, floor(25 * dc_sc)), 'b');
gfx_set(dc_text_r, dc_text_g, dc_text_b, 1);
gfx_x = dc_ox + 30 * dc_sc; gfx_y = dc_oy + 22 * dc_sc;
gfx_drawstr("DRUMCLOUD");
gfx_setfont(1, "Arial", max(8, floor(10 * dc_sc)), 'b');
gfx_set(dc_gold_r, dc_gold_g, dc_gold_b, 1);
gfx_x = dc_ox + 30 * dc_sc; gfx_y = dc_oy + 55 * dc_sc;
gfx_drawstr("v0.27.1  /  REAKIT GUI");

gfx_setfont(1, "Arial", max(8, floor(10 * dc_sc)));
gfx_set(dc_text_r, dc_text_g, dc_text_b, 0.65);
gfx_x = dc_ox + 430 * dc_sc; gfx_y = dc_oy + 30 * dc_sc;
analysis_status == 3 ? gfx_drawstr("ROOT: ANALYZING...") :
analysis_status == 2 ? gfx_drawstr("ROOT: NO RELIABLE PITCH") :
(analysis_status == 1 || analysis_status == 4) ? (
  gfx_drawstr("ROOT: MIDI "); gfx_drawnumber(detected_root_note, 0);
  gfx_drawstr("  /  "); gfx_drawnumber(detected_cents, 1); gfx_drawstr(" cents");
) : gfx_drawstr("ROOT DETECTION READY");

// Compact live status in the top bar.
gfx_setfont(1,"Arial",max(8,floor(9*dc_sc)),'b');
active_voices>0 ? gfx_set(dc_gold_r,dc_gold_g,dc_gold_b,1) : gfx_set(dc_text_r,dc_text_g,dc_text_b,0.42);
gfx_x=dc_ox+890*dc_sc; gfx_y=dc_oy+29*dc_sc; gfx_drawstr("VOICES "); gfx_drawnumber(active_voices,0);
active_grains>0 ? gfx_set(dc_gold_r,dc_gold_g,dc_gold_b,1) : gfx_set(dc_text_r,dc_text_g,dc_text_b,0.42);
gfx_x=dc_ox+1010*dc_sc; gfx_y=dc_oy+29*dc_sc; gfx_drawstr("GRAINS "); gfx_drawnumber(active_grains,0);

// --------------------------------------------------
// CUSTOM DRUMCLOUD WAVEFORM / GRAIN VISUALISATION
// --------------------------------------------------
wave_x = dc_ox + 30 * dc_sc;
wave_y = dc_oy + 82 * dc_sc;
wave_w = 1120 * dc_sc;
wave_h = 220 * dc_sc;

gfx_set(0.018, 0.023, 0.034, 1);
gfx_rect(wave_x, wave_y, wave_w, wave_h);
gfx_set(dc_line_r, dc_line_g, dc_line_b, 0.8);
gfx_line(wave_x, wave_y + wave_h * 0.5, wave_x + wave_w, wave_y + wave_h * 0.5);

mouse_inside_wave = mx >= wave_x && mx <= wave_x + wave_w &&
                    my >= wave_y && my <= wave_y + wave_h;
mouse_inside_wave && LMB ? (
  grain_position = max(range_start, min(range_end, (mx - wave_x) / wave_w));
  scan_position = grain_position;
  dc_automate(4);
  dc_wave_touch = 1;
);
dc_wave_touch && !LMB ? (dc_automate_end(4); dc_wave_touch=0;);

frame_count > 1 ? (
  gfx_set(0.32, 0.48, 0.62, 0.95);
  dc_wx = 0; dc_last_wy = wave_y + wave_h * 0.5;
  loop(floor(wave_w),
    dc_norm_x = dc_wx / max(1, wave_w - 1);
    dc_wave_frame = floor(dc_norm_x * (frame_count - 1));
    sample_channels == 1 ? dc_wave_value = sample_buffer[dc_wave_frame] : (
      dc_wave_index = dc_wave_frame * sample_channels;
      dc_wave_value = (sample_buffer[dc_wave_index] + sample_buffer[dc_wave_index + 1]) * 0.5;
    );
    dc_wave_y = wave_y + wave_h * 0.5 - dc_wave_value * wave_h * 0.43;
    dc_wx > 0 ? gfx_line(wave_x + dc_wx - 1, dc_last_wy, wave_x + dc_wx, dc_wave_y);
    dc_last_wy = dc_wave_y; dc_wx += 1;
  );
);

range_start_x = wave_x + range_start * wave_w;
range_end_x = wave_x + range_end * wave_w;
gfx_set(dc_bg_r, dc_bg_g, dc_bg_b, 0.82);
gfx_rect(wave_x, wave_y, max(0, range_start_x - wave_x), wave_h);
gfx_rect(range_end_x, wave_y, max(0, wave_x + wave_w - range_end_x), wave_h);
gfx_set(dc_gold_r, dc_gold_g, dc_gold_b, 0.58);
gfx_line(range_start_x, wave_y, range_start_x, wave_y + wave_h);
gfx_line(range_end_x, wave_y, range_end_x, wave_y + wave_h);
gfx_triangle(range_start_x, wave_y, range_start_x+10*dc_sc, wave_y,
             range_start_x, wave_y+10*dc_sc);
gfx_triangle(range_end_x, wave_y, range_end_x-10*dc_sc, wave_y,
             range_end_x, wave_y+10*dc_sc);

frame_count > 1 ? (
  gfx_grain_i = 0;
  loop(max_grains,
    active_base[gfx_grain_i] && retire_base[gfx_grain_i] <= 0 &&
    valid_number(start_base[gfx_grain_i]) && valid_number(phase_base[gfx_grain_i]) &&
    valid_number(step_base[gfx_grain_i]) && valid_number(length_base[gfx_grain_i]) &&
    length_base[gfx_grain_i] >= 1 ? (
      grain_current_pos = start_base[gfx_grain_i] + phase_base[gfx_grain_i] * step_base[gfx_grain_i];
      grain_marker_pos = max(0, min(1, grain_current_pos / frame_count));
      grain_marker_x = wave_x + grain_marker_pos * wave_w;
      grain_progress = max(0, min(1, phase_base[gfx_grain_i] / max(1, length_base[gfx_grain_i])));
      marker_alpha = 0.20 + 0.80 * (1 - grain_progress);
      gfx_set(dc_gold_r, dc_gold_g, dc_gold_b, marker_alpha);
      gfx_line(grain_marker_x, wave_y + 8 * dc_sc, grain_marker_x, wave_y + wave_h - 8 * dc_sc);
      gfx_circle(grain_marker_x, wave_y + wave_h * 0.5, max(2, 3 * dc_sc), 1);
    );
    gfx_grain_i += 1;
  );
);

position_x = wave_x + grain_position * wave_w;
gfx_set(1.0, 0.82, 0.30, 1);
gfx_line(position_x, wave_y, position_x, wave_y + wave_h);
gfx_triangle(position_x - 6 * dc_sc, wave_y, position_x + 6 * dc_sc, wave_y,
             position_x, wave_y + 9 * dc_sc);
mouse_inside_wave ? (
  gfx_set(1, 1, 1, 0.10); gfx_line(mx, wave_y, mx, wave_y + wave_h);
);
gfx_set(dc_line_r, dc_line_g, dc_line_b, 1);
gfx_rect(wave_x, wave_y, wave_w, wave_h, 0);

// --------------------------------------------------
// GRAIN PANEL
// --------------------------------------------------
dc_panel_x = dc_ox + 30 * dc_sc; dc_panel_y = dc_oy + 326 * dc_sc;
dc_panel_w = 550 * dc_sc; dc_panel_h = 248 * dc_sc;
gfx_set(dc_panel_r, dc_panel_g, dc_panel_b, 1);
gfx_rect(dc_panel_x, dc_panel_y, dc_panel_w, dc_panel_h);
gfx_set(dc_line_r, dc_line_g, dc_line_b, 1);
gfx_rect(dc_panel_x, dc_panel_y, dc_panel_w, dc_panel_h, 0);
gfx_setfont(1, "Arial", max(9, floor(12 * dc_sc)), 'b');
gfx_set(dc_gold_r, dc_gold_g, dc_gold_b, 1);
gfx_x = dc_panel_x + 16 * dc_sc; gfx_y = dc_panel_y + 11 * dc_sc; gfx_drawstr("GRAIN");
gfx_set(dc_line_r, dc_line_g, dc_line_b, 1);
gfx_rect(dc_panel_x + 16 * dc_sc, dc_panel_y + 34 * dc_sc, dc_panel_w - 32 * dc_sc, 1);

// Primary: large Serum controls. Accent arguments color ring and pointer;
// panel arguments color the unlit track. Values remain the original sliders.
dc_cy = dc_panel_y + 126 * dc_sc;
dc_r_main = 42 * dc_sc;
dc_x1 = dc_panel_x + 85 * dc_sc;
dc_x2 = dc_panel_x + 205 * dc_sc;
dc_nv = rk_knob_interact(17, dc_m_grain_size, dc_x1, dc_cy, dc_r_main,
                         grain_size_ms, 10, 1000, 180, 0);
dc_nv != grain_size_ms ? (grain_size_ms = dc_nv; dc_automate(3););
rk_knob_draw(17, dc_x1, dc_cy, dc_r_main, grain_size_ms, 10, 1000, 0,
             dc_m_grain_size[0], dc_gold_r, dc_gold_g, dc_gold_b, 0,
             dc_panel_r, dc_panel_g, dc_panel_b);
dc_nv = rk_knob_interact(17, dc_m_density, dc_x2, dc_cy, dc_r_main,
                         density, 1, 40, 8, 0);
dc_nv != density ? (
  density = dc_nv;
  // Explicit zero-based bitmask makes REAPER's last-touched target
  // unambiguous even though slider5 has the named alias `density`.
  dc_automate(5);
);
rk_knob_draw(17, dc_x2, dc_cy, dc_r_main, density, 1, 40, 0,
             dc_m_density[0], dc_gold_r, dc_gold_g, dc_gold_b, 0,
             dc_panel_r, dc_panel_g, dc_panel_b);

// Secondary: smaller Encoder controls. ReaKit 1.3 applies cr/cg/cb to the LED
// field; its stock Encoder pointer is intentionally white (library limitation).
dc_r_small = 22 * dc_sc;
dc_x3 = dc_panel_x + 315 * dc_sc; dc_x4 = dc_panel_x + 390 * dc_sc;
dc_x5 = dc_panel_x + 465 * dc_sc; dc_x6 = dc_panel_x + 525 * dc_sc;
dc_nv = rk_knob_interact(11, dc_m_position_spread, dc_x3, dc_cy, dc_r_small,
                         position_spread, 0, 1, 0.10, 0);
dc_nv != position_spread ? (position_spread = dc_nv; dc_automate(6););
rk_knob_draw(11, dc_x3, dc_cy, dc_r_small, position_spread, 0, 1, 0,
             dc_m_position_spread[0], dc_gold_r, dc_gold_g, dc_gold_b, 0,
             dc_panel_r, dc_panel_g, dc_panel_b);
dc_nv = rk_knob_interact(11, dc_m_stereo_spread, dc_x4, dc_cy, dc_r_small,
                         stereo_spread, 0, 1, 0.50, 0);
dc_nv != stereo_spread ? (stereo_spread = dc_nv; dc_automate(9););
rk_knob_draw(11, dc_x4, dc_cy, dc_r_small, stereo_spread, 0, 1, 0,
             dc_m_stereo_spread[0], dc_gold_r, dc_gold_g, dc_gold_b, 0,
             dc_panel_r, dc_panel_g, dc_panel_b);
dc_nv = rk_knob_interact(11, dc_m_attack, dc_x5, dc_cy, dc_r_small,
                         attack_ms, 0, 500, 10, 0);
dc_nv != attack_ms ? (attack_ms = dc_nv; dc_automate(15););
rk_knob_draw(11, dc_x5, dc_cy, dc_r_small, attack_ms, 0, 500, 0,
             dc_m_attack[0], dc_gold_r, dc_gold_g, dc_gold_b, 0,
             dc_panel_r, dc_panel_g, dc_panel_b);
dc_nv = rk_knob_interact(11, dc_m_release, dc_x6, dc_cy, dc_r_small,
                         release_ms, 0, 1000, 80, 0);
dc_nv != release_ms ? (release_ms = dc_nv; dc_automate(16););
rk_knob_draw(11, dc_x6, dc_cy, dc_r_small, release_ms, 0, 1000, 0,
             dc_m_release[0], dc_gold_r, dc_gold_g, dc_gold_b, 0,
             dc_panel_r, dc_panel_g, dc_panel_b);

// Labels and live values.
gfx_setfont(1, "Arial", max(8, floor(10 * dc_sc)), 'b');
gfx_set(dc_text_r, dc_text_g, dc_text_b, 0.92);
gfx_measurestr("GRAIN SIZE", dc_tw, dc_th); gfx_x = dc_x1 - dc_tw/2; gfx_y = dc_panel_y + 190*dc_sc; gfx_drawstr("GRAIN SIZE");
gfx_measurestr("DENSITY", dc_tw, dc_th); gfx_x = dc_x2 - dc_tw/2; gfx_y = dc_panel_y + 190*dc_sc; gfx_drawstr("DENSITY");
gfx_setfont(1, "Arial", max(7, floor(8 * dc_sc)), 'b');
gfx_measurestr("POSITION", dc_tw, dc_th); gfx_x = dc_x3 - dc_tw/2; gfx_y = dc_panel_y + 166*dc_sc; gfx_drawstr("POSITION");
gfx_measurestr("STEREO", dc_tw, dc_th); gfx_x = dc_x4 - dc_tw/2; gfx_y = dc_panel_y + 166*dc_sc; gfx_drawstr("STEREO");
gfx_measurestr("ATTACK", dc_tw, dc_th); gfx_x = dc_x5 - dc_tw/2; gfx_y = dc_panel_y + 166*dc_sc; gfx_drawstr("ATTACK");
gfx_measurestr("RELEASE", dc_tw, dc_th); gfx_x = dc_x6 - dc_tw/2; gfx_y = dc_panel_y + 166*dc_sc; gfx_drawstr("RELEASE");
gfx_setfont(1, "Arial", max(8, floor(9 * dc_sc)));
gfx_set(dc_gold_r, dc_gold_g, dc_gold_b, 0.95);
gfx_x = dc_x1 - 25*dc_sc; gfx_y = dc_panel_y + 213*dc_sc; gfx_drawnumber(grain_size_ms, 0); gfx_drawstr(" ms");
gfx_x = dc_x2 - 22*dc_sc; gfx_y = dc_panel_y + 213*dc_sc; gfx_drawnumber(density, 1); gfx_drawstr(" Hz");
gfx_x = dc_x3 - 14*dc_sc; gfx_y = dc_panel_y + 189*dc_sc; gfx_drawnumber(position_spread*100, 0); gfx_drawstr("%");
gfx_x = dc_x4 - 14*dc_sc; gfx_y = dc_panel_y + 189*dc_sc; gfx_drawnumber(stereo_spread*100, 0); gfx_drawstr("%");
gfx_x = dc_x5 - 15*dc_sc; gfx_y = dc_panel_y + 189*dc_sc; gfx_drawnumber(attack_ms, 0); gfx_drawstr("ms");
gfx_x = dc_x6 - 15*dc_sc; gfx_y = dc_panel_y + 189*dc_sc; gfx_drawnumber(release_ms, 0); gfx_drawstr("ms");

// --------------------------------------------------
// MOTION / POSITION PANEL
// --------------------------------------------------
dc_motion_x = dc_ox + 600*dc_sc; dc_motion_y = dc_oy + 326*dc_sc;
dc_motion_w = 550*dc_sc; dc_motion_h = 248*dc_sc;
gfx_set(dc_panel_r, dc_panel_g, dc_panel_b, 1); gfx_rect(dc_motion_x, dc_motion_y, dc_motion_w, dc_motion_h);
gfx_set(dc_line_r, dc_line_g, dc_line_b, 1); gfx_rect(dc_motion_x, dc_motion_y, dc_motion_w, dc_motion_h, 0);
gfx_setfont(1, "Arial", max(9, floor(12*dc_sc)), 'b'); gfx_set(dc_gold_r, dc_gold_g, dc_gold_b, 1);
gfx_x = dc_motion_x + 16*dc_sc; gfx_y = dc_motion_y + 10*dc_sc; gfx_drawstr("MOTION");
gfx_set(dc_line_r, dc_line_g, dc_line_b, 1); gfx_rect(dc_motion_x + 16*dc_sc, dc_motion_y + 33*dc_sc, dc_motion_w - 32*dc_sc, 1);

dc_motion_cy = dc_motion_y + 126*dc_sc;
dc_pos_x = dc_motion_x + 60*dc_sc; dc_scan_x = dc_motion_x + 145*dc_sc;
dc_start_x = dc_motion_x + 230*dc_sc; dc_end_x = dc_motion_x + 310*dc_sc;
dc_nv = rk_knob_interact(17, dc_m_position, dc_pos_x, dc_motion_cy, 28*dc_sc, grain_position, 0, 1, 0.50, 0);
dc_nv != grain_position ? (grain_position = dc_nv; scan_position = grain_position; dc_automate(4););
rk_knob_draw(17, dc_pos_x, dc_motion_cy, 28*dc_sc, grain_position, 0, 1, 0, dc_m_position[0], dc_gold_r, dc_gold_g, dc_gold_b, 0, dc_panel_r, dc_panel_g, dc_panel_b);
dc_nv = rk_knob_interact(17, dc_m_scan_speed, dc_scan_x, dc_motion_cy, 28*dc_sc, scan_speed, -1, 1, 0.05, 0);
dc_nv != scan_speed ? (scan_speed = dc_nv; dc_automate(7););
rk_knob_draw(17, dc_scan_x, dc_motion_cy, 28*dc_sc, scan_speed, -1, 1, 1, dc_m_scan_speed[0], dc_gold_r, dc_gold_g, dc_gold_b, 0, dc_panel_r, dc_panel_g, dc_panel_b);
// Encoder LEDs extend beyond their nominal radius. A 29 px design radius keeps
// the actual hit target usable when the whole interface is scaled down.
dc_range_r = 29*dc_sc;
dc_nv = rk_knob_interact(11, dc_m_sample_start, dc_start_x, dc_motion_cy, dc_range_r, sample_start, 0, 1, 0, 0);
dc_nv != sample_start ? (sample_start = dc_nv; dc_automate(12););
rk_knob_draw(11, dc_start_x, dc_motion_cy, dc_range_r, sample_start, 0, 1, 0, dc_m_sample_start[0], dc_gold_r, dc_gold_g, dc_gold_b, 0, dc_panel_r, dc_panel_g, dc_panel_b);
dc_nv = rk_knob_interact(11, dc_m_sample_end, dc_end_x, dc_motion_cy, dc_range_r, sample_end, 0, 1, 1, 0);
dc_nv != sample_end ? (sample_end = dc_nv; dc_automate(13););
rk_knob_draw(11, dc_end_x, dc_motion_cy, dc_range_r, sample_end, 0, 1, 0, dc_m_sample_end[0], dc_gold_r, dc_gold_g, dc_gold_b, 0, dc_panel_r, dc_panel_g, dc_panel_b);

// Programmatic writes from @gfx do not guarantee that @slider runs before the
// next paint. Mirror its range normalization here for immediate visual feedback.
range_start = min(sample_start, sample_end);
range_end = max(sample_start, sample_end);
range_end - range_start < 0.001 ? (
  range_end = min(1, range_start + 0.001);
  range_end - range_start < 0.001 ? range_start = max(0, range_end - 0.001);
);
grain_position = max(range_start, min(range_end, grain_position));
scan_position = max(range_start, min(range_end, scan_position));

gfx_setfont(1, "Arial", max(7, floor(8*dc_sc)), 'b'); gfx_set(dc_text_r, dc_text_g, dc_text_b, 0.9);
gfx_measurestr("POSITION",dc_tw,dc_th); gfx_x=dc_pos_x-dc_tw/2; gfx_y=dc_motion_y+164*dc_sc; gfx_drawstr("POSITION");
gfx_measurestr("SCAN SPEED",dc_tw,dc_th); gfx_x=dc_scan_x-dc_tw/2; gfx_y=dc_motion_y+164*dc_sc; gfx_drawstr("SCAN SPEED");
gfx_measurestr("START",dc_tw,dc_th); gfx_x=dc_start_x-dc_tw/2; gfx_y=dc_motion_y+164*dc_sc; gfx_drawstr("START");
gfx_measurestr("END",dc_tw,dc_th); gfx_x=dc_end_x-dc_tw/2; gfx_y=dc_motion_y+164*dc_sc; gfx_drawstr("END");
gfx_setfont(1, "Arial", max(7, floor(8*dc_sc))); gfx_set(dc_gold_r, dc_gold_g, dc_gold_b, 0.95);
gfx_x=dc_pos_x-13*dc_sc; gfx_y=dc_motion_y+184*dc_sc; gfx_drawnumber(grain_position*100,0); gfx_drawstr("%");
gfx_x=dc_scan_x-18*dc_sc; gfx_y=dc_motion_y+184*dc_sc; gfx_drawnumber(scan_speed,2);
gfx_x=dc_start_x-13*dc_sc; gfx_y=dc_motion_y+184*dc_sc; gfx_drawnumber(sample_start*100,0); gfx_drawstr("%");
gfx_x=dc_end_x-13*dc_sc; gfx_y=dc_motion_y+184*dc_sc; gfx_drawnumber(sample_end*100,0); gfx_drawstr("%");

// Scan toggle and five-way position-mode selector use ReaKit buttons.
dc_btn_x = dc_motion_x + 350*dc_sc; dc_btn_y = dc_motion_y + 79*dc_sc;
dc_nv = btn_pill_interact(dc_m_scan_on, dc_btn_x, dc_btn_y, 74*dc_sc, 26*dc_sc, scan_on);
dc_nv != scan_on ? (scan_on = dc_nv; dc_automate_discrete(8););
gfx_setfont(1, "Arial", max(7, floor(8*dc_sc)), 'b');
btn_pill_draw(dc_btn_x, dc_btn_y, 74*dc_sc, 26*dc_sc, scan_on, "SCAN", dc_m_scan_on[0], dc_gold_r, dc_gold_g, dc_gold_b);

dc_seg_x = dc_motion_x + 350*dc_sc; dc_seg_y = dc_motion_y + 139*dc_sc;
dc_seg_gap = 2*dc_sc; dc_seg_w = 37*dc_sc; dc_seg_h = 25*dc_sc;
dc_nv = btn_segment_interact(dc_m_position_mode, dc_seg_x, dc_seg_y, dc_seg_w, dc_seg_h, 5, dc_seg_gap, position_mode);
dc_nv != position_mode ? (position_mode = dc_nv; dc_automate_discrete(11););
btn_segment_draw(dc_seg_x, dc_seg_y, dc_seg_w, dc_seg_h, 0, position_mode, "FWD", dc_m_position_mode[0], dc_gold_r, dc_gold_g, dc_gold_b);
btn_segment_draw(dc_seg_x+(dc_seg_w+dc_seg_gap), dc_seg_y, dc_seg_w, dc_seg_h, 1, position_mode, "BACK", dc_m_position_mode[0], dc_gold_r, dc_gold_g, dc_gold_b);
btn_segment_draw(dc_seg_x+2*(dc_seg_w+dc_seg_gap), dc_seg_y, dc_seg_w, dc_seg_h, 2, position_mode, "PING", dc_m_position_mode[0], dc_gold_r, dc_gold_g, dc_gold_b);
btn_segment_draw(dc_seg_x+3*(dc_seg_w+dc_seg_gap), dc_seg_y, dc_seg_w, dc_seg_h, 3, position_mode, "JUMP", dc_m_position_mode[0], dc_gold_r, dc_gold_g, dc_gold_b);
btn_segment_draw(dc_seg_x+4*(dc_seg_w+dc_seg_gap), dc_seg_y, dc_seg_w, dc_seg_h, 4, position_mode, "WALK", dc_m_position_mode[0], dc_gold_r, dc_gold_g, dc_gold_b);
gfx_setfont(1, "Arial", max(7, floor(8*dc_sc)), 'b'); gfx_set(dc_text_r,dc_text_g,dc_text_b,0.65);
gfx_x=dc_seg_x; gfx_y=dc_motion_y+121*dc_sc; gfx_drawstr("POSITION MODE");

// --------------------------------------------------
// PITCH / TUNING PANEL
// --------------------------------------------------
dc_pitch_x=dc_ox+30*dc_sc; dc_pitch_y=dc_oy+590*dc_sc;
dc_pitch_w=550*dc_sc; dc_pitch_h=176*dc_sc;
gfx_set(dc_panel_r,dc_panel_g,dc_panel_b,1); gfx_rect(dc_pitch_x,dc_pitch_y,dc_pitch_w,dc_pitch_h);
gfx_set(dc_line_r,dc_line_g,dc_line_b,1); gfx_rect(dc_pitch_x,dc_pitch_y,dc_pitch_w,dc_pitch_h,0);
gfx_setfont(1,"Arial",max(9,floor(12*dc_sc)),'b'); gfx_set(dc_gold_r,dc_gold_g,dc_gold_b,1);
gfx_x=dc_pitch_x+16*dc_sc; gfx_y=dc_pitch_y+10*dc_sc; gfx_drawstr("PITCH");
gfx_set(dc_line_r,dc_line_g,dc_line_b,1); gfx_rect(dc_pitch_x+16*dc_sc,dc_pitch_y+33*dc_sc,dc_pitch_w-32*dc_sc,1);

dc_pitch_cy=dc_pitch_y+89*dc_sc;
dc_root_x=dc_pitch_x+70*dc_sc; dc_spread_x=dc_pitch_x+165*dc_sc; dc_fine_x=dc_pitch_x+260*dc_sc;
dc_nv=rk_knob_interact(11,dc_m_root_note,dc_root_x,dc_pitch_cy,28*dc_sc,root_note,0,127,60,128);
dc_nv!=root_note ? (root_note=floor(dc_nv+0.5); manual_root_note=root_note; dc_automate(2););
rk_knob_draw(11,dc_root_x,dc_pitch_cy,28*dc_sc,root_note,0,127,0,dc_m_root_note[0],dc_gold_r,dc_gold_g,dc_gold_b,128,dc_panel_r,dc_panel_g,dc_panel_b);
dc_nv=rk_knob_interact(17,dc_m_pitch_spread,dc_spread_x,dc_pitch_cy,28*dc_sc,pitch_spread,0,12,0,0);
dc_nv!=pitch_spread ? (pitch_spread=dc_nv; dc_automate(14););
rk_knob_draw(17,dc_spread_x,dc_pitch_cy,28*dc_sc,pitch_spread,0,12,0,dc_m_pitch_spread[0],dc_gold_r,dc_gold_g,dc_gold_b,0,dc_panel_r,dc_panel_g,dc_panel_b);
dc_nv=rk_knob_interact(11,dc_m_fine_tune,dc_fine_x,dc_pitch_cy,28*dc_sc,fine_tune,-100,100,0,0);
dc_nv!=fine_tune ? (fine_tune=dc_nv; dc_automate(33););
rk_knob_draw(11,dc_fine_x,dc_pitch_cy,28*dc_sc,fine_tune,-100,100,1,dc_m_fine_tune[0],dc_gold_r,dc_gold_g,dc_gold_b,0,dc_panel_r,dc_panel_g,dc_panel_b);

gfx_setfont(1,"Arial",max(7,floor(8*dc_sc)),'b'); gfx_set(dc_text_r,dc_text_g,dc_text_b,0.9);
gfx_measurestr("ROOT NOTE",dc_tw,dc_th); gfx_x=dc_root_x-dc_tw/2; gfx_y=dc_pitch_y+124*dc_sc; gfx_drawstr("ROOT NOTE");
gfx_measurestr("SPREAD",dc_tw,dc_th); gfx_x=dc_spread_x-dc_tw/2; gfx_y=dc_pitch_y+124*dc_sc; gfx_drawstr("SPREAD");
