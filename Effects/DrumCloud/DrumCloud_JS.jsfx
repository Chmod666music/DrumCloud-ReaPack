gfx_x=dc_density_x-13*dc_sc; gfx_y=dc_source_y+134*dc_sc; gfx_drawnumber(density_spread*100,0); gfx_drawstr("%");

dc_dir_x=dc_source_x+18*dc_sc; dc_dir_y=dc_source_y+119*dc_sc;
dc_dir_gap=3*dc_sc; dc_dir_w=58*dc_sc; dc_dir_h=25*dc_sc;
dc_nv=btn_segment_interact(dc_m_grain_direction,dc_dir_x,dc_dir_y,dc_dir_w,dc_dir_h,4,dc_dir_gap,grain_direction);
dc_nv!=grain_direction ? (grain_direction=dc_nv; dc_automate_discrete(30););
btn_segment_draw(dc_dir_x,dc_dir_y,dc_dir_w,dc_dir_h,0,grain_direction,"F",dc_m_grain_direction[0],dc_gold_r,dc_gold_g,dc_gold_b);
btn_segment_draw(dc_dir_x+dc_dir_w+dc_dir_gap,dc_dir_y,dc_dir_w,dc_dir_h,1,grain_direction,"B",dc_m_grain_direction[0],dc_gold_r,dc_gold_g,dc_gold_b);
btn_segment_draw(dc_dir_x+2*(dc_dir_w+dc_dir_gap),dc_dir_y,dc_dir_w,dc_dir_h,2,grain_direction,"ALT",dc_m_grain_direction[0],dc_gold_r,dc_gold_g,dc_gold_b);
btn_segment_draw(dc_dir_x+3*(dc_dir_w+dc_dir_gap),dc_dir_y,dc_dir_w,dc_dir_h,3,grain_direction,"RND",dc_m_grain_direction[0],dc_gold_r,dc_gold_g,dc_gold_b);
gfx_setfont(1,"Arial",max(7,floor(8*dc_sc)),'b'); gfx_set(dc_text_r,dc_text_g,dc_text_b,0.65);
gfx_x=dc_dir_x; gfx_y=dc_source_y+99*dc_sc; gfx_drawstr("GRAIN DIRECTION");

// Close continuous touch sessions on drag release, wheel steps and resets.
dc_end_if_released(dc_m_grain_size,3);
dc_end_if_released(dc_m_density,5);
dc_end_if_released(dc_m_position_spread,6);
dc_end_if_released(dc_m_stereo_spread,9);
dc_end_if_released(dc_m_attack,15);
dc_end_if_released(dc_m_release,16);
dc_end_if_released(dc_m_position,4);
dc_end_if_released(dc_m_scan_speed,7);
dc_end_if_released(dc_m_sample_start,12);
dc_end_if_released(dc_m_sample_end,13);
dc_end_if_released(dc_m_root_note,2);
dc_end_if_released(dc_m_pitch_spread,14);
dc_end_if_released(dc_m_fine_tune,33);
dc_end_if_released(dc_m_reverb_mix,18);
dc_end_if_released(dc_m_reverb_size,19);
dc_end_if_released(dc_m_reverb_decay,20);
dc_end_if_released(dc_m_reverb_damping,21);
dc_end_if_released(dc_m_shimmer,22);
dc_end_if_released(dc_m_delay_time_l,24);
dc_end_if_released(dc_m_delay_time_r,25);
dc_end_if_released(dc_m_delay_feedback,26);
dc_end_if_released(dc_m_delay_mix,27);
dc_end_if_released(dc_m_delay_damping,28);
dc_end_if_released(dc_m_output,10);
dc_end_if_released(dc_m_density_spread,31);

dc_prev_lmb = LMB; dc_prev_rmb = RMB; dc_prev_wheel = mouse_wheel;
